# Get your free API key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_READ_ACCESS_TOKEN=your_tmdb_read_access_token_here

# Supabase — carousel endpoint
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Stream server — internal only, never exposed publicly
# Default: http://127.0.0.1:4444 (explicit IPv4 loopback avoids IPv6 resolution issues)
STREAM_SERVER_URL=https://servers.jpaworx.com
