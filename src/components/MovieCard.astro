---
import { imgUrl, formatYear, formatRating, ratingColor } from '../lib/tmdb';
import { moviePath, tvPath } from '../lib/slugify';
import type { Movie, TVShow } from '../lib/tmdb';

interface Props {
  item: Movie | TVShow;
  type: 'movie' | 'tv';
  /** Lazy load images below fold */
  lazy?: boolean;
}

const { item, type, lazy = true } = Astro.props;

const isMovie = type === 'movie';
const title   = isMovie ? (item as Movie).title : (item as TVShow).name;
const date    = isMovie ? (item as Movie).release_date : (item as TVShow).first_air_date;
const year    = formatYear(date);
const href    = isMovie
  ? moviePath(title, year, item.id)
  : tvPath(title, year, item.id);
const rating  = formatRating(item.vote_average);
const rClass  = ratingColor(item.vote_average);
const poster  = imgUrl(item.poster_path, 'w300');
const label   = item.vote_average >= 7.5 ? 'Great' : item.vote_average >= 6 ? 'Good' : 'Fair';
---

<article class="card">
  <a href={href} class="card__link" aria-label={`View details for ${title}`}>
    <div class="card__poster">
      <img
        src={poster}
        alt={`${title} poster`}
        width="300"
        height="450"
        loading={lazy ? 'lazy' : 'eager'}
        decoding="async"
        class="card__img"
      />

      <!-- Centered play button on hover -->
      <div class="card__overlay" aria-hidden="true">
        <span class="card__play">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M8 5.14v14l11-7-11-7z"/>
          </svg>
        </span>
      </div>

      <!-- Info overlay at bottom (same as NetflixTop10) -->
      <div class="card__info">
        <div class={`card__rating ${rClass}`} aria-hidden="true">
          <svg class="card__rating-star" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
          </svg>
          <span class="card__rating-score">{rating}</span>
          <span class="card__rating-divider" aria-hidden="true"></span>
          <span class="card__rating-label">{label}</span>
        </div>
        <h3 class="card__title" title={title}>{title}</h3>
        <div class="card__meta">
          <span class="card__year">{year}</span>
          <span class="card__type-pill">{isMovie ? 'Movie' : 'Series'}</span>
        </div>
      </div>
    </div>
  </a>
</article>

<style>
  .card {
    --card-w: 100%;
    width: var(--card-w);
  }

  .card__link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  /* ── Poster shell ─────────────────────────────────────────── */
  .card__poster {
    position: relative;
    aspect-ratio: 2 / 3;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--clr-bg-card);
    box-shadow: var(--shadow-card);
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }

  .card:hover .card__poster {
    transform: translateY(-6px) scale(1.03);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.7);
  }

  .card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--transition-base);
  }

  .card:hover .card__img {
    transform: scale(1.04);
  }

  /* ── Centered play button ─────────────────────────────────── */
  .card__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity var(--transition-base);
    /* sits above poster, below info overlay */
    z-index: 1;
  }

  .card:hover .card__overlay {
    opacity: 1;
  }

  .card__play {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--clr-accent);
    color: #fff;
    box-shadow: 0 0 24px rgba(124, 58, 237, 0.6);
    transform: scale(0.8);
    transition: transform var(--transition-spring);
  }

  .card:hover .card__play {
    transform: scale(1);
  }

  /* ── Info overlay at bottom ───────────────────────────────── */
  .card__info {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 3rem var(--space-3) var(--space-3);
    background: linear-gradient(
      to bottom,
      transparent 0%,
      rgba(5, 5, 12, 0.7) 30%,
      rgba(5, 5, 12, 0.95) 65%,
      rgb(5, 5, 12) 100%
    );
    pointer-events: none;
    z-index: 2;
  }

  /* ── Apple TV-style rating badge ──────────────────────────── */
  .card__rating {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 3px 7px 3px 5px;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    margin-bottom: var(--space-1);
  }

  .card__rating-star {
    width: 10px;
    height: 10px;
    flex-shrink: 0;
  }

  .card__rating.rating--high .card__rating-star { color: #fbbf24; }
  .card__rating.rating--mid  .card__rating-star { color: #fb923c; }
  .card__rating.rating--low  .card__rating-star { color: #f87171; }

  .card__rating-score {
    font-size: 0.65rem;
    font-weight: 700;
    color: #fff;
    line-height: 1;
  }

  .card__rating-divider {
    display: inline-block;
    width: 1px;
    height: 10px;
    background: rgba(255, 255, 255, 0.3);
    margin-inline: 1px;
    flex-shrink: 0;
  }

  .card__rating-label {
    font-size: 0.6rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.7);
    letter-spacing: 0.02em;
    line-height: 1;
  }

  /* ── Title & meta ─────────────────────────────────────────── */
  .card__title {
    font-size: var(--text-sm);
    font-weight: 700;
    color: #fff;
    line-height: 1.25;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin: 0 0 var(--space-1);
    transition: color var(--transition-fast);
    pointer-events: auto;
  }

  .card:hover .card__title {
    color: var(--clr-accent);
  }

  .card__meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0;
  }

  .card__year {
    font-size: 0.7rem;
    color: rgba(255, 255, 255, 0.6);
  }

  .card__type-pill {
    background: rgba(255, 255, 255, 0.15);
    padding: 1px 6px;
    border-radius: 99px;
    font-size: 0.65rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.6);
  }
</style>
