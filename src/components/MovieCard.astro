---
import { imgUrl, formatYear, formatRating, ratingColor } from '../lib/tmdb';
import { moviePath, tvPath } from '../lib/slugify';
import type { Movie, TVShow } from '../lib/tmdb';

interface Props {
  item: Movie | TVShow;
  type: 'movie' | 'tv';
  /** Lazy load images below fold */
  lazy?: boolean;
}

const { item, type, lazy = true } = Astro.props;

const isMovie = type === 'movie';
const title   = isMovie ? (item as Movie).title : (item as TVShow).name;
const date    = isMovie ? (item as Movie).release_date : (item as TVShow).first_air_date;
const year    = formatYear(date);
const href    = isMovie
  ? moviePath(title, year, item.id)
  : tvPath(title, year, item.id);
const rating  = formatRating(item.vote_average);
const rClass  = ratingColor(item.vote_average);
const poster  = imgUrl(item.poster_path, 'w300');
const alt     = `${title} poster`;
---

<article class="card">
  <a href={href} class="card__link" aria-label={`View details for ${title}`}>
    <div class="card__poster">
      <img
        src={poster}
        alt={alt}
        width="300"
        height="450"
        loading={lazy ? 'lazy' : 'eager'}
        decoding="async"
        class="card__img"
      />
      <div class="card__overlay" aria-hidden="true">
        <span class="card__play">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M8 5.14v14l11-7-11-7z"/>
          </svg>
        </span>
      </div>
      <div class="card__badge-wrap" aria-hidden="true">
        <span class={`card__rating ${rClass}`}>
          <svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
          </svg>
          {rating}
        </span>
      </div>
    </div>

    <div class="card__info">
      <h3 class="card__title" title={title}>{title}</h3>
      <div class="card__meta">
        <span class="card__year">{year}</span>
        <span class="card__type">{isMovie ? 'Movie' : 'Series'}</span>
      </div>
    </div>
  </a>
</article>

<style>
  .card {
    --card-w: 100%;
    width: var(--card-w);
  }

  .card__link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .card__poster {
    position: relative;
    aspect-ratio: 2 / 3;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--clr-bg-card);
    box-shadow: var(--shadow-card);
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }

  .card:hover .card__poster {
    will-change: transform;
    transform: scale(1.03) translateY(-4px);
    box-shadow: 0 12px 40px rgba(0,0,0,0.7);
  }

  .card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: filter var(--transition-base);
  }

  .card:hover .card__img {
    filter: brightness(0.65);
  }

  /* Hover overlay */
  .card__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity var(--transition-base);
  }

  .card:hover .card__overlay {
    opacity: 1;
  }

  .card__play {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--clr-accent);
    color: #fff;
    box-shadow: 0 0 24px rgba(229,9,20,0.6);
    transform: scale(0.8);
    transition: transform var(--transition-spring);
  }

  .card:hover .card__play {
    transform: scale(1);
  }

  /* Rating badge */
  .card__badge-wrap {
    position: absolute;
    top: var(--space-2);
    left: var(--space-2);
  }

  .card__rating {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    padding: 3px 7px;
    border-radius: var(--radius-full);
    background: rgba(10,10,15,0.85);
    backdrop-filter: blur(6px);
    font-size: var(--text-xs);
    font-weight: 700;
    line-height: 1;
  }

  /* Card info */
  .card__info {
    padding: var(--space-3) var(--space-1) var(--space-1);
  }

  .card__title {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--clr-text);
    line-height: 1.3;
    /* truncate to 2 lines */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin-bottom: var(--space-1);
    transition: color var(--transition-fast);
  }

  .card:hover .card__title {
    color: var(--clr-accent);
  }

  .card__meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .card__year {
    font-size: var(--text-xs);
    color: var(--clr-text-muted);
  }

  .card__type {
    font-size: var(--text-xs);
    color: var(--clr-text-muted);
    padding: 1px 6px;
    border: 1px solid var(--clr-border);
    border-radius: var(--radius-sm);
  }
</style>
