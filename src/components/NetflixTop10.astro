---
import type { NetflixTop10Item } from '../lib/tmdb';
import { imgUrl, formatYear, formatRating, ratingColor } from '../lib/tmdb';
import { moviePath, tvPath } from '../lib/slugify';

interface Props {
  items: NetflixTop10Item[];
}

const { items } = Astro.props;

function getTitle(item: NetflixTop10Item): string {
  return 'title' in item.media ? item.media.title : item.media.name;
}

function getYear(item: NetflixTop10Item): string {
  const date = 'release_date' in item.media
    ? item.media.release_date
    : item.media.first_air_date;
  return formatYear(date);
}

function getDetailPath(item: NetflixTop10Item): string {
  const title = getTitle(item);
  const year = getYear(item);
  return item.type === 'movie'
    ? moviePath(title, year, item.media.id)
    : tvPath(title, year, item.media.id);
}

// Pad rank number: 1 → "01", 10 → "10"
function padRank(rank: number): string {
  return rank.toString().padStart(2, '0');
}
---

{items.length > 0 && (
  <section class="top10">
    <div class="container">
      <div class="top10__header">
        <div class="top10__badge">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M4 2h16v20l-8-4-8 4V2z"/>
          </svg>
          Netflix
        </div>
        <h2 class="section-title">Top 10 Today</h2>
      </div>

      <div class="top10__scroll-wrapper">
        <ul class="top10__track" id="top10-track">
          {items.map((item) => {
            const title = getTitle(item);
            const year = getYear(item);
            const poster = imgUrl(item.media.poster_path, 'w300');
            const rating = formatRating(item.media.vote_average);
            const rClass = ratingColor(item.media.vote_average);
            const detailHref = getDetailPath(item);

            return (
              <li class="top10__item">
                <span class="top10__rank" aria-label={`Number ${item.rank}`}>
                  {padRank(item.rank)}
                </span>

                <div class="top10__card">
                  <!-- Poster -->
                  <a href={detailHref} class="top10__poster-link" tabindex="-1" aria-hidden="true">
                    <img
                      src={poster}
                      alt={`${title} poster`}
                      class="top10__poster"
                      width="160"
                      height="240"
                      loading="lazy"
                      decoding="async"
                    />
                  </a>

                  <!-- Info overlay at bottom -->
                  <div class="top10__info">
                    <div class={`top10__rating ${rClass}`}>{rating}</div>
                    <h3 class="top10__title">
                      <a href={detailHref}>{title}</a>
                    </h3>
                    <p class="top10__meta">
                      <span>{year}</span>
                      <span class="top10__type-pill">{item.type === 'movie' ? 'Movie' : 'Series'}</span>
                    </p>
                  </div>

                </div>
              </li>
            );
          })}
        </ul>

        <!-- Scroll arrows (desktop) -->
        <button class="top10__arrow top10__arrow--left" id="top10-prev" aria-label="Scroll left">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="15,18 9,12 15,6"/>
          </svg>
        </button>
        <button class="top10__arrow top10__arrow--right" id="top10-next" aria-label="Scroll right">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="9,18 15,12 9,6"/>
          </svg>
        </button>
      </div>
    </div>
  </section>
)}

<script>
  const track   = document.getElementById('top10-track')    as HTMLUListElement | null;
  const btnPrev = document.getElementById('top10-prev')     as HTMLButtonElement | null;
  const btnNext = document.getElementById('top10-next')     as HTMLButtonElement | null;

  if (track && btnPrev && btnNext) {
    const scrollAmount = () => {
      const card = track.querySelector('.top10__item') as HTMLElement | null;
      if (!card) return 280;
      return card.offsetWidth + 12; // card width + gap
    };

    btnPrev.addEventListener('click', () => {
      track.scrollBy({ left: -scrollAmount() * 3, behavior: 'smooth' });
    });
    btnNext.addEventListener('click', () => {
      track.scrollBy({ left: scrollAmount() * 3, behavior: 'smooth' });
    });
  }
</script>

<style>
  /* ── Section wrapper ─────────────────────────────────────── */
  .top10 {
    padding-block: var(--space-10) var(--space-8);
  }

  /* ── Header ──────────────────────────────────────────────── */
  .top10__header {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
  }

  .top10__badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 3px 10px 3px 7px;
    background: #e50914;
    color: #fff;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    border-radius: 4px;
    line-height: 1;
  }

  .section-title {
    font-size: var(--text-2xl);
    font-weight: 700;
    color: var(--clr-text);
    margin: 0;
  }

  /* ── Scrollable wrapper ──────────────────────────────────── */
  .top10__scroll-wrapper {
    position: relative;
  }

  /* ── Track (horizontal scroll list) ─────────────────────── */
  .top10__track {
    display: flex;
    gap: 0;               /* gap lives inside each item via padding */
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding-block: var(--space-2);
    list-style: none;
    margin: 0;
    padding-inline: 0;
  }

  .top10__track::-webkit-scrollbar { display: none; }

  /* ── Individual item (rank number + card) ────────────────── */
  .top10__item {
    flex: 0 0 auto;
    display: flex;
    align-items: flex-end;
    scroll-snap-align: start;
    /* The big rank number overlaps left edge of card by ~30px */
    padding-right: 12px;
  }

  /* ── Giant rank number ───────────────────────────────────── */
  .top10__rank {
    font-family: 'Bebas Neue', 'Arial Black', sans-serif;
    font-size: clamp(6rem, 10vw, 9rem);
    font-weight: 900;
    line-height: 0.8;
    /* Outlined / hollow look */
    color: transparent;
    -webkit-text-stroke: 3px rgba(255, 255, 255, 0.25);
    text-stroke: 3px rgba(255, 255, 255, 0.25);
    /* Pull rank into the card's left side */
    margin-right: -28px;
    position: relative;
    z-index: 1;
    flex-shrink: 0;
    user-select: none;
    /* Subtle text shadow for depth */
    filter: drop-shadow(0 2px 8px rgba(0,0,0,0.6));
    transition: -webkit-text-stroke var(--transition-base);
  }

  .top10__item:hover .top10__rank {
    -webkit-text-stroke: 3px rgba(255, 255, 255, 0.5);
    text-stroke: 3px rgba(255, 255, 255, 0.5);
  }

  /* First item: no negative left margin (nothing to overlap) */
  .top10__item:first-child {
    padding-left: 0;
  }

  /* ── Card shell ──────────────────────────────────────────── */
  .top10__card {
    position: relative;
    width: 160px;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--clr-bg-2);
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.5);
    transition: transform var(--transition-base), box-shadow var(--transition-base);
    z-index: 2;
    flex-shrink: 0;
  }

  .top10__card:hover {
    transform: translateY(-6px) scale(1.03);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.7);
  }

  /* ── Poster ──────────────────────────────────────────────── */
  .top10__poster-link {
    display: block;
    aspect-ratio: 2 / 3;
  }

  .top10__poster {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--transition-base);
  }

  .top10__card:hover .top10__poster {
    transform: scale(1.04);
  }

  /* ── Info overlay (title / meta) ─────────────────────────── */
  .top10__info {
    padding: var(--space-6) var(--space-3) var(--space-3);
    background: linear-gradient(
      to bottom,
      transparent,
      rgba(10, 10, 20, 0.85) 35%,
      var(--clr-bg-2) 100%
    );
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    pointer-events: none;
  }

  .top10__rating {
    display: inline-block;
    font-size: 0.65rem;
    font-weight: 700;
    padding: 1px 5px;
    border-radius: 4px;
    margin-bottom: var(--space-1);
  }

  .top10__rating.rating--high { background: #1db954; color: #fff; }
  .top10__rating.rating--mid  { background: #f59e0b; color: #000; }
  .top10__rating.rating--low  { background: #ef4444; color: #fff; }

  .top10__title {
    font-size: 0.8rem;
    font-weight: 700;
    line-height: 1.25;
    margin: 0 0 var(--space-1);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    pointer-events: auto;
  }

  .top10__title a {
    color: var(--clr-text);
    text-decoration: none;
    transition: color var(--transition-base);
  }

  .top10__title a:hover {
    color: var(--clr-accent);
  }

  .top10__meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 0.7rem;
    color: var(--clr-text-muted);
    margin: 0;
  }

  .top10__type-pill {
    background: rgba(255,255,255,0.1);
    padding: 1px 6px;
    border-radius: 99px;
    font-size: 0.65rem;
    font-weight: 600;
  }

  /* ── Scroll arrows ───────────────────────────────────────── */
  .top10__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid rgba(255,255,255,0.15);
    background: rgba(10, 10, 20, 0.75);
    backdrop-filter: blur(8px);
    color: var(--clr-text);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity var(--transition-base), background var(--transition-base);
    pointer-events: none;
  }

  .top10__scroll-wrapper:hover .top10__arrow {
    opacity: 1;
    pointer-events: auto;
  }

  .top10__arrow:hover {
    background: rgba(255,255,255,0.15);
  }

  .top10__arrow--left  { left: -20px; }
  .top10__arrow--right { right: -20px; }

  /* ── Responsive ──────────────────────────────────────────── */
  @media (max-width: 768px) {
    .top10__rank {
      font-size: clamp(4rem, 14vw, 6.5rem);
      -webkit-text-stroke: 2px rgba(255, 255, 255, 0.25);
      text-stroke: 2px rgba(255, 255, 255, 0.25);
      margin-right: -20px;
    }

    .top10__card { width: 130px; }

    .top10__arrow { display: none; }
  }

  @media (max-width: 480px) {
    .top10__rank {
      font-size: clamp(3.5rem, 15vw, 5rem);
      margin-right: -16px;
    }

    .top10__card { width: 110px; }
  }
</style>
