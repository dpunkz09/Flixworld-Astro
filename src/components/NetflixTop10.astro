---
import type { NetflixTop10Item } from '../lib/tmdb';
import { imgUrl, formatYear, formatRating, ratingColor } from '../lib/tmdb';
import { moviePath, tvPath } from '../lib/slugify';

interface Props {
  items:  NetflixTop10Item[];   // movies
  shows:  NetflixTop10Item[];   // tv shows
}

const { items, shows } = Astro.props;

function getTitle(item: NetflixTop10Item): string {
  return 'title' in item.media ? item.media.title : item.media.name;
}

function getYear(item: NetflixTop10Item): string {
  const date = 'release_date' in item.media
    ? item.media.release_date
    : item.media.first_air_date;
  return formatYear(date);
}

function getDetailPath(item: NetflixTop10Item): string {
  const title = getTitle(item);
  const year  = getYear(item);
  return item.type === 'movie'
    ? moviePath(title, year, item.media.id)
    : tvPath(title, year, item.media.id);
}

function padRank(rank: number): string {
  return rank.toString().padStart(2, '0');
}

const hasMovies = items.length > 0;
const hasShows  = shows.length > 0;
const hasAny    = hasMovies || hasShows;
---

{hasAny && (
  <section class="top10">
    <div class="container">

      <!-- Header + Tabs inline -->
      <div class="top10__header">
        <div class="top10__badge">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M4 2h16v20l-8-4-8 4V2z"/>
          </svg>
          Netflix
        </div>
        <h2 class="section-title">This Week's Top 10</h2>

        <div class="top10__tabs" role="tablist" aria-label="Top 10 categories">
          {hasMovies && (
            <button
              class:list={['top10__tab', { 'top10__tab--active': hasMovies }]}
              id="tab-movies"
              role="tab"
              aria-selected={hasMovies ? 'true' : 'false'}
              aria-controls="panel-movies"
              type="button"
            >
              Movies
            </button>
          )}
          {hasShows && (
            <button
              class:list={['top10__tab', { 'top10__tab--active': !hasMovies }]}
              id="tab-shows"
              role="tab"
              aria-selected={!hasMovies ? 'true' : 'false'}
              aria-controls="panel-shows"
              type="button"
            >
              TV Shows
            </button>
          )}
        </div>
      </div>

      <!-- Movies panel -->
      {hasMovies && (
        <div id="panel-movies" role="tabpanel" aria-labelledby="tab-movies">
          <div class="top10__scroll-wrapper">
            <ul class="top10__track" id="top10-movies-track">
              {items.map((item) => {
                const title      = getTitle(item);
                const year       = getYear(item);
                const poster     = imgUrl(item.media.poster_path, 'w300');
                const rating     = formatRating(item.media.vote_average);
                const rClass     = ratingColor(item.media.vote_average);
                const detailHref = getDetailPath(item);
                return (
                  <li class="top10__item">
                    <span class="top10__rank" aria-label={`Number ${item.rank}`}>{padRank(item.rank)}</span>
                    <div class="top10__card">
                      <a href={detailHref} class="top10__poster-link" tabindex="-1" aria-hidden="true">
                        <img src={poster} alt={`${title} poster`} class="top10__poster" width="160" height="240" loading="lazy" decoding="async" />
                      </a>
                      <div class="top10__info">
                        <div class={`top10__rating ${rClass}`}>
                          <svg class="top10__rating-star" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                          <span class="top10__rating-score">{rating}</span>
                          <span class="top10__rating-divider" aria-hidden="true"></span>
                          <span class="top10__rating-label">{item.media.vote_average >= 7.5 ? 'Great' : item.media.vote_average >= 6 ? 'Good' : 'Fair'}</span>
                        </div>
                        <h3 class="top10__title"><a href={detailHref}>{title}</a></h3>
                        <p class="top10__meta">
                          <span>{year}</span>
                          <span class="top10__type-pill">Movie</span>
                        </p>
                      </div>
                    </div>
                  </li>
                );
              })}
            </ul>
            <button class="top10__arrow top10__arrow--left" data-track="top10-movies-track" aria-label="Scroll left">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15,18 9,12 15,6"/></svg>
            </button>
            <button class="top10__arrow top10__arrow--right" data-track="top10-movies-track" aria-label="Scroll right">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9,18 15,12 9,6"/></svg>
            </button>
          </div>
        </div>
      )}

      <!-- TV Shows panel -->
      {hasShows && (
        <div id="panel-shows" role="tabpanel" aria-labelledby="tab-shows" hidden={hasMovies ? true : undefined}>
          <div class="top10__scroll-wrapper">
            <ul class="top10__track" id="top10-shows-track">
              {shows.map((item) => {
                const title      = getTitle(item);
                const year       = getYear(item);
                const poster     = imgUrl(item.media.poster_path, 'w300');
                const rating     = formatRating(item.media.vote_average);
                const rClass     = ratingColor(item.media.vote_average);
                const detailHref = getDetailPath(item);
                return (
                  <li class="top10__item">
                    <span class="top10__rank" aria-label={`Number ${item.rank}`}>{padRank(item.rank)}</span>
                    <div class="top10__card">
                      <a href={detailHref} class="top10__poster-link" tabindex="-1" aria-hidden="true">
                        <img src={poster} alt={`${title} poster`} class="top10__poster" width="160" height="240" loading="lazy" decoding="async" />
                      </a>
                      <div class="top10__info">
                        <div class={`top10__rating ${rClass}`}>
                          <svg class="top10__rating-star" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                          <span class="top10__rating-score">{rating}</span>
                          <span class="top10__rating-divider" aria-hidden="true"></span>
                          <span class="top10__rating-label">{item.media.vote_average >= 7.5 ? 'Great' : item.media.vote_average >= 6 ? 'Good' : 'Fair'}</span>
                        </div>
                        <h3 class="top10__title"><a href={detailHref}>{title}</a></h3>
                        <p class="top10__meta">
                          <span>{year}</span>
                          <span class="top10__type-pill">Series</span>
                        </p>
                      </div>
                    </div>
                  </li>
                );
              })}
            </ul>
            <button class="top10__arrow top10__arrow--left" data-track="top10-shows-track" aria-label="Scroll left">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15,18 9,12 15,6"/></svg>
            </button>
            <button class="top10__arrow top10__arrow--right" data-track="top10-shows-track" aria-label="Scroll right">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9,18 15,12 9,6"/></svg>
            </button>
          </div>
        </div>
      )}

    </div>
  </section>
)}

<script>
  // ── Tabs ─────────────────────────────────────────────────
  const tabs   = document.querySelectorAll<HTMLButtonElement>('.top10__tab');
  const panels = document.querySelectorAll<HTMLElement>('[role="tabpanel"]');

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const target = tab.getAttribute('aria-controls');

      tabs.forEach(t => {
        t.setAttribute('aria-selected', 'false');
        t.classList.remove('top10__tab--active');
      });
      panels.forEach(p => p.setAttribute('hidden', ''));

      tab.setAttribute('aria-selected', 'true');
      tab.classList.add('top10__tab--active');
      document.getElementById(target!)?.removeAttribute('hidden');
    });
  });

  // ── Scroll arrows ────────────────────────────────────────
  document.querySelectorAll<HTMLButtonElement>('.top10__arrow').forEach(btn => {
    btn.addEventListener('click', () => {
      const trackId = btn.dataset.track;
      const track   = trackId ? document.getElementById(trackId) as HTMLUListElement | null : null;
      if (!track) return;
      const card   = track.querySelector<HTMLElement>('.top10__item');
      const amount = card ? (card.offsetWidth + 12) * 3 : 480;
      const dir    = btn.classList.contains('top10__arrow--right') ? amount : -amount;
      track.scrollBy({ left: dir, behavior: 'smooth' });
    });
  });
</script>

<style>
  /* ── Section ─────────────────────────────────────────────── */
  .top10 {
    padding-block: var(--space-10) var(--space-8);
  }

  /* ── Header ──────────────────────────────────────────────── */
  .top10__header {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-5);
    flex-wrap: wrap;
  }

  .top10__badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 3px 10px 3px 7px;
    background: #e50914;
    color: #fff;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    border-radius: 4px;
    line-height: 1;
  }

  .section-title {
    font-size: var(--text-2xl);
    font-weight: 700;
    color: var(--clr-text);
    margin: 0;
  }

  /* ── Tabs ────────────────────────────────────────────────── */
  .top10__tabs {
    display: flex;
    gap: 4px;
    margin-left: auto;
    background: rgba(255,255,255,0.05);
    border: 1px solid var(--clr-border);
    border-radius: var(--radius-full);
    padding: 3px;
  }

  .top10__tab {
    display: inline-flex;
    align-items: center;
    padding: 4px 12px;
    border-radius: var(--radius-full);
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--clr-text-muted);
    background: transparent;
    border: none;
    cursor: pointer;
    transition: all var(--transition-fast);
    white-space: nowrap;
    line-height: 1.4;
  }

  .top10__tab:hover { color: var(--clr-text); }

  .top10__tab--active {
    background: var(--clr-accent);
    color: #fff;
    box-shadow: 0 1px 6px rgba(124,58,237,0.4);
  }

  /* ── Panel hidden override ───────────────────────────────── */
  [role="tabpanel"][hidden] { display: none; }

  /* ── Scroll wrapper ──────────────────────────────────────── */
  .top10__scroll-wrapper { position: relative; }

  /* ── Track ───────────────────────────────────────────────── */
  .top10__track {
    display: flex;
    gap: 0;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding-block: var(--space-2);
    list-style: none;
    margin: 0;
    padding-inline: 0;
  }

  .top10__track::-webkit-scrollbar { display: none; }

  /* ── Item ────────────────────────────────────────────────── */
  .top10__item {
    flex: 0 0 auto;
    display: flex;
    align-items: flex-end;
    scroll-snap-align: start;
    padding-right: 12px;
  }

  .top10__item:first-child { padding-left: 0; }

  /* ── Rank number ─────────────────────────────────────────── */
  .top10__rank {
    font-family: 'Bebas Neue', 'Arial Black', sans-serif;
    font-size: clamp(6rem, 10vw, 9rem);
    font-weight: 900;
    line-height: 0.8;
    color: transparent;
    -webkit-text-stroke: 3px rgba(255,255,255,0.25);
    text-stroke: 3px rgba(255,255,255,0.25);
    margin-right: -28px;
    position: relative;
    z-index: 1;
    flex-shrink: 0;
    user-select: none;
    filter: drop-shadow(0 2px 8px rgba(0,0,0,0.6));
    transition: -webkit-text-stroke var(--transition-base);
  }

  .top10__item:hover .top10__rank {
    -webkit-text-stroke: 3px rgba(255,255,255,0.5);
    text-stroke: 3px rgba(255,255,255,0.5);
  }

  /* ── Card ────────────────────────────────────────────────── */
  .top10__card {
    position: relative;
    width: 160px;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--clr-bg-2);
    box-shadow: 0 4px 24px rgba(0,0,0,0.5);
    transition: transform var(--transition-base), box-shadow var(--transition-base);
    z-index: 2;
    flex-shrink: 0;
  }

  .top10__card:hover {
    transform: translateY(-6px) scale(1.03);
    box-shadow: 0 12px 40px rgba(0,0,0,0.7);
  }

  /* ── Poster ──────────────────────────────────────────────── */
  .top10__poster-link { display: block; aspect-ratio: 2 / 3; }

  .top10__poster {
    width: 100%; height: 100%; object-fit: cover; display: block;
    transition: transform var(--transition-base);
  }

  .top10__card:hover .top10__poster { transform: scale(1.04); }

  /* ── Info overlay ────────────────────────────────────────── */
  .top10__info {
    padding: var(--space-6) var(--space-3) var(--space-3);
    background: linear-gradient(to bottom, transparent, rgba(10,10,20,0.85) 35%, var(--clr-bg-2) 100%);
    position: absolute;
    bottom: 0; left: 0; right: 0;
    pointer-events: none;
  }

  /* ── Rating badge ────────────────────────────────────────── */
  .top10__rating {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 3px 7px 3px 5px;
    border-radius: 6px;
    background: rgba(255,255,255,0.1);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(255,255,255,0.12);
    margin-bottom: var(--space-1);
    pointer-events: none;
  }

  .top10__rating-star { width: 10px; height: 10px; flex-shrink: 0; }

  .top10__rating.rating--high .top10__rating-star { color: #fbbf24; }
  .top10__rating.rating--mid  .top10__rating-star { color: #fb923c; }
  .top10__rating.rating--low  .top10__rating-star { color: #f87171; }

  .top10__rating-score  { font-size: 0.65rem; font-weight: 700; color: #fff; line-height: 1; }
  .top10__rating-divider { display: inline-block; width: 1px; height: 10px; background: rgba(255,255,255,0.3); margin-inline: 1px; flex-shrink: 0; }
  .top10__rating-label  { font-size: 0.6rem; font-weight: 600; color: rgba(255,255,255,0.7); letter-spacing: 0.02em; line-height: 1; }

  /* ── Title / meta ────────────────────────────────────────── */
  .top10__title {
    font-size: 0.8rem; font-weight: 700; line-height: 1.25;
    margin: 0 0 var(--space-1);
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
    pointer-events: auto;
  }

  .top10__title a { color: var(--clr-text); text-decoration: none; transition: color var(--transition-base); }
  .top10__title a:hover { color: var(--clr-accent); }

  .top10__meta { display: flex; align-items: center; gap: var(--space-2); font-size: 0.7rem; color: var(--clr-text-muted); margin: 0; }

  .top10__type-pill { background: rgba(255,255,255,0.1); padding: 1px 6px; border-radius: 99px; font-size: 0.65rem; font-weight: 600; }

  /* ── Scroll arrows ───────────────────────────────────────── */
  .top10__arrow {
    position: absolute; top: 50%; transform: translateY(-50%); z-index: 10;
    width: 40px; height: 40px; border-radius: 50%;
    border: 1px solid rgba(255,255,255,0.15);
    background: rgba(10,10,20,0.75); backdrop-filter: blur(8px);
    color: var(--clr-text); cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    opacity: 0; transition: opacity var(--transition-base), background var(--transition-base);
    pointer-events: none;
  }

  .top10__scroll-wrapper:hover .top10__arrow { opacity: 1; pointer-events: auto; }
  .top10__arrow:hover { background: rgba(255,255,255,0.15); }
  .top10__arrow--left  { left:  -20px; }
  .top10__arrow--right { right: -20px; }

  /* ── Responsive ──────────────────────────────────────────── */
  @media (max-width: 768px) {
    .top10__rank { font-size: clamp(4rem,14vw,6.5rem); -webkit-text-stroke: 2px rgba(255,255,255,0.25); text-stroke: 2px rgba(255,255,255,0.25); margin-right: -20px; }
    .top10__card { width: 130px; }
    .top10__arrow { display: none; }
  }

  @media (max-width: 480px) {
    .top10__rank { font-size: clamp(3.5rem,15vw,5rem); margin-right: -16px; }
    .top10__card { width: 110px; }
  }
</style>
