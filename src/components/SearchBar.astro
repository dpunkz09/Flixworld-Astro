---
interface Props {
  /** Initial value, used on search page */
  initialQuery?: string;
  /** Render as large hero style */
  large?: boolean;
  placeholder?: string;
}

const {
  initialQuery = '',
  large = false,
  placeholder = 'Search movies, TV shows...',
} = Astro.props;
---

<form
  class:list={['search-bar', { 'search-bar--large': large }]}
  action="/search"
  method="get"
  role="search"
  aria-label="Search content"
>
  <label for="search-input" class="sr-only">Search</label>
  <div class="search-bar__inner">
    <svg
      class="search-bar__icon"
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <circle cx="11" cy="11" r="8"/>
      <path d="m21 21-4.35-4.35"/>
    </svg>

    <input
      id="search-input"
      class="search-bar__input"
      type="search"
      name="q"
      value={initialQuery}
      placeholder={placeholder}
      autocomplete="off"
      spellcheck="false"
      aria-label={placeholder}
    />

    {initialQuery && (
      <button type="button" class="search-bar__clear" id="search-clear" aria-label="Clear search">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path d="M18 6 6 18M6 6l12 12"/>
        </svg>
      </button>
    )}

    <button type="submit" class="search-bar__submit" aria-label="Submit search">
      Search
    </button>
  </div>
</form>

<script>
  const input   = document.getElementById('search-input') as HTMLInputElement | null;
  const clear   = document.getElementById('search-clear');

  clear?.addEventListener('click', () => {
    if (input) {
      input.value = '';
      input.focus();
    }
  });

  // Show/hide clear button dynamically
  input?.addEventListener('input', () => {
    if (clear) {
      clear.style.display = input.value ? 'flex' : 'none';
    }
  });
</script>

<style>
  .search-bar {
    width: 100%;
    max-width: 560px;
  }

  .search-bar--large {
    max-width: 680px;
  }

  .search-bar__inner {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    background: var(--clr-bg-elevated);
    border: 1px solid var(--clr-border-strong);
    border-radius: var(--radius-full);
    padding: var(--space-2) var(--space-2) var(--space-2) var(--space-4);
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .search-bar__inner:focus-within {
    border-color: var(--clr-accent);
    box-shadow: 0 0 0 3px var(--clr-accent-muted);
  }

  .search-bar--large .search-bar__inner {
    padding: var(--space-3) var(--space-3) var(--space-3) var(--space-5);
  }

  .search-bar__icon {
    color: var(--clr-text-muted);
    flex-shrink: 0;
  }

  .search-bar__input {
    flex: 1;
    background: none;
    border: none;
    outline: none;
    color: var(--clr-text);
    font-size: var(--text-sm);
    min-width: 0;
  }

  .search-bar--large .search-bar__input {
    font-size: var(--text-base);
  }

  .search-bar__input::placeholder {
    color: var(--clr-text-muted);
  }

  /* Clear native "x" button in WebKit */
  .search-bar__input::-webkit-search-cancel-button {
    -webkit-appearance: none;
  }

  .search-bar__clear {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: none;
    border: none;
    color: var(--clr-text-muted);
    cursor: pointer;
    flex-shrink: 0;
    transition: color var(--transition-fast), background var(--transition-fast);
  }

  .search-bar__clear:hover {
    color: var(--clr-text);
    background: rgba(255,255,255,0.08);
  }

  .search-bar__submit {
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-full);
    background: var(--clr-accent);
    color: #fff;
    border: none;
    font-size: var(--text-sm);
    font-weight: 600;
    cursor: pointer;
    flex-shrink: 0;
    transition: background var(--transition-fast), transform var(--transition-fast);
  }

  .search-bar--large .search-bar__submit {
    padding: var(--space-3) var(--space-6);
    font-size: var(--text-base);
  }

  .search-bar__submit:hover {
    background: var(--clr-accent-hover);
  }

  .search-bar__submit:active {
    transform: scale(0.96);
  }
</style>
