---
export const prerender = false;

import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import {
  getTVDetails,
  getTVRecommendations,
  imgUrl,
  formatRating,
  formatYear,
  ratingColor,
} from '../../../../../lib/tmdb';

const { id, season, episode } = Astro.params;
const showId  = Number(id);
const seasonN = Math.max(1, Number(season)  || 1);
const episodeN = Math.max(1, Number(episode) || 1);

if (!id || isNaN(showId)) return Astro.redirect('/404');

let show, recommendations;
try {
  [show, recommendations] = await Promise.all([
    getTVDetails(showId),
    getTVRecommendations(showId),
  ]);
} catch {
  return Astro.redirect('/404');
}

const recs       = recommendations.results.slice(0, 12);
const rating     = formatRating(show.vote_average);
const rClass     = ratingColor(show.vote_average);
const year       = formatYear(show.first_air_date);
const poster     = imgUrl(show.poster_path, 'w300');
const totalSeasons  = show.number_of_seasons  ?? 1;
const totalEpisodes = show.number_of_episodes ?? 1;

const embedUrl = `https://embed.flixworld.xyz/embed/tv/${showId}/${seasonN}/${episodeN}`;
---

<BaseLayout
  title={`Watch ${show.name} S${seasonN}E${episodeN}`}
  description={`Stream ${show.name} Season ${seasonN} Episode ${episodeN} on StreamVault.`}
  image={imgUrl(show.backdrop_path, 'w780')}
>
  <div class="watch-page">
    <!-- Player -->
    <div class="watch-player-wrap">
      <div class="watch-player" id="player-container">
        <iframe
          id="player-iframe"
          src={embedUrl}
          title={`Watch ${show.name} S${seasonN}E${episodeN}`}
          allow="autoplay; encrypted-media; fullscreen; picture-in-picture"
          allowfullscreen
          class="watch-player__iframe"
          loading="eager"
        ></iframe>
      </div>
    </div>

    <!-- Body -->
    <div class="watch-body container">
      <div class="watch-main">
        <!-- Breadcrumb -->
        <nav class="watch-breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span aria-hidden="true">›</span>
          <a href="/tv">TV Shows</a>
          <span aria-hidden="true">›</span>
          <a href={`/tv/${show.id}`}>{show.name}</a>
          <span aria-hidden="true">›</span>
          <span aria-current="page">S{seasonN} E{episodeN}</span>
        </nav>

        <!-- Show info -->
        <div class="watch-info">
          <img
            src={poster}
            alt={`${show.name} poster`}
            width="300" height="450"
            loading="lazy" decoding="async"
            class="watch-info__poster"
          />
          <div class="watch-info__text">
            <h1 class="watch-info__title">
              {show.name}
              <span class="watch-info__year">({year})</span>
            </h1>
            <p class="watch-info__ep-label">
              Season {seasonN} &nbsp;·&nbsp; Episode {episodeN}
            </p>
            <div class="watch-info__meta">
              <span class={`watch-info__rating ${rClass}`}>
                <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                </svg>
                {rating}
              </span>
              {show.genres && show.genres.length > 0 && (
                <>
                  <span class="dot" aria-hidden="true">·</span>
                  <span>{show.genres.slice(0, 3).map(g => g.name).join(', ')}</span>
                </>
              )}
            </div>
            {show.overview && <p class="watch-info__overview">{show.overview}</p>}
            <div class="watch-info__actions">
              <a href={`/tv/${show.id}`} class="btn btn--ghost">← Back to Details</a>
            </div>
          </div>
        </div>

        <!-- Episode navigator -->
        <div class="ep-nav" aria-label="Episode navigation">
          <h2 class="ep-nav__title">Episodes</h2>
          <div class="ep-nav__controls">
            <div class="ep-nav__selects">
              <label class="ep-nav__label" for="season-select">Season</label>
              <select id="season-select" class="ep-nav__select" aria-label="Select season">
                {Array.from({ length: totalSeasons }, (_, i) => i + 1).map(s => (
                  <option value={s} selected={s === seasonN}>{s}</option>
                ))}
              </select>
              <label class="ep-nav__label" for="episode-input">Episode</label>
              <input
                id="episode-input"
                class="ep-nav__ep-input"
                type="number"
                min="1"
                value={episodeN}
                aria-label="Episode number"
              />
              <button id="load-ep" class="btn btn--primary">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M8 5.14v14l11-7-11-7z"/>
                </svg>
                Play
              </button>
            </div>

            <!-- Prev / Next -->
            <div class="ep-nav__arrows">
              {(seasonN > 1 || episodeN > 1) && (
                <a
                  href={episodeN > 1
                    ? `/watch/tv/${show.id}/${seasonN}/${episodeN - 1}`
                    : `/watch/tv/${show.id}/${seasonN - 1}/1`}
                  class="btn btn--ghost"
                  aria-label="Previous episode"
                >
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                    <path d="m15 18-6-6 6-6"/>
                  </svg>
                  Prev
                </a>
              )}
              <a
                href={`/watch/tv/${show.id}/${seasonN}/${episodeN + 1}`}
                class="btn btn--ghost"
                aria-label="Next episode"
              >
                Next
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <path d="m9 18 6-6-6-6"/>
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Sidebar -->
      {recs.length > 0 && (
        <aside class="watch-sidebar" aria-label="More like this">
          <h2 class="watch-sidebar__title">More Like This</h2>
          <ul class="watch-sidebar__list" role="list">
            {recs.map(item => {
              const recRating = formatRating(item.vote_average);
              const recClass  = ratingColor(item.vote_average);
              const recYear   = formatYear(item.first_air_date);
              return (
                <li>
                  <a href={`/watch/tv/${item.id}/1/1`} class="sidebar-card">
                    <div class="sidebar-card__poster">
                      <img
                        src={imgUrl(item.poster_path, 'w185')}
                        alt={item.name}
                        width="185" height="278"
                        loading="lazy" decoding="async"
                      />
                      <span class={`sidebar-card__rating ${recClass}`}>★ {recRating}</span>
                    </div>
                    <div class="sidebar-card__info">
                      <p class="sidebar-card__title">{item.name}</p>
                      <p class="sidebar-card__year">{recYear}</p>
                      <p class="sidebar-card__overview">{item.overview}</p>
                    </div>
                  </a>
                </li>
              );
            })}
          </ul>
        </aside>
      )}
    </div>
  </div>
</BaseLayout>

<script define:vars={{ showId, baseUrl: `/watch/tv/${showId}` }}>
  const loadBtn      = document.getElementById('load-ep');
  const seasonSel    = document.getElementById('season-select');
  const episodeInput = document.getElementById('episode-input');

  loadBtn?.addEventListener('click', () => {
    const s = seasonSel?.value  || '1';
    const e = episodeInput?.value || '1';
    window.location.href = `${baseUrl}/${s}/${e}`;
  });

  // Also navigate on Enter in episode input
  episodeInput?.addEventListener('keydown', e => {
    if (e.key === 'Enter') loadBtn?.click();
  });
</script>

<style>
  .watch-page {
    min-height: 100dvh;
    background: #000;
    padding-top: var(--navbar-h);
  }

  .watch-player-wrap {
    width: 100%;
    background: #000;
    position: sticky;
    top: var(--navbar-h);
    z-index: 10;
    height: min(56.25vw, 60vh);
  }

  .watch-player {
    width: 100%;
    height: 100%;
    background: #000;
    position: relative;
  }

  .watch-player__iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: none;
  }

  .watch-body {
    display: grid;
    grid-template-columns: 1fr 360px;
    gap: var(--space-8);
    padding-block: var(--space-8) var(--space-16);
    align-items: start;
    background: var(--clr-bg);
  }

  .watch-main {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    min-width: 0;
  }

  .watch-breadcrumb {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--clr-text-muted);
    flex-wrap: wrap;
  }

  .watch-breadcrumb a { color: var(--clr-text-secondary); transition: color var(--transition-fast); }
  .watch-breadcrumb a:hover { color: var(--clr-accent); }

  .watch-info {
    display: flex;
    gap: var(--space-6);
    align-items: flex-start;
  }

  .watch-info__poster {
    width: 100px;
    flex-shrink: 0;
    border-radius: var(--radius-lg);
    object-fit: cover;
    height: auto;
    box-shadow: var(--shadow-md);
  }

  .watch-info__text {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .watch-info__title {
    font-family: var(--font-display);
    font-size: clamp(var(--text-2xl), 3vw, var(--text-4xl));
    letter-spacing: 0.02em;
    line-height: 1.1;
    color: var(--clr-text);
  }

  .watch-info__year { color: var(--clr-text-muted); font-size: 0.7em; margin-left: var(--space-2); }

  .watch-info__ep-label {
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--clr-accent);
  }

  .watch-info__meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
    font-size: var(--text-sm);
    color: var(--clr-text-secondary);
  }

  .watch-info__rating {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-weight: 700;
  }

  .dot { color: var(--clr-text-muted); }

  .watch-info__overview {
    font-size: var(--text-sm);
    color: var(--clr-text-secondary);
    line-height: 1.7;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .watch-info__actions { display: flex; gap: var(--space-3); flex-wrap: wrap; }

  /* Episode navigator */
  .ep-nav {
    background: var(--clr-bg-card);
    border: 1px solid var(--clr-border);
    border-radius: var(--radius-xl);
    padding: var(--space-5) var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .ep-nav__title {
    font-size: var(--text-sm);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--clr-text-muted);
  }

  .ep-nav__controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .ep-nav__selects {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .ep-nav__label {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--clr-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .ep-nav__select,
  .ep-nav__ep-input {
    background: var(--clr-bg-elevated);
    border: 1px solid var(--clr-border-strong);
    border-radius: var(--radius-md);
    color: var(--clr-text);
    font-size: var(--text-sm);
    font-weight: 600;
    padding: var(--space-2) var(--space-3);
    cursor: pointer;
  }

  .ep-nav__select { min-width: 100px; }
  .ep-nav__ep-input { width: 72px; text-align: center; }

  .ep-nav__select:focus,
  .ep-nav__ep-input:focus {
    outline: none;
    border-color: var(--clr-accent);
    box-shadow: 0 0 0 3px var(--clr-accent-muted);
  }

  .ep-nav__ep-input::-webkit-outer-spin-button,
  .ep-nav__ep-input::-webkit-inner-spin-button { -webkit-appearance: none; }
  .ep-nav__ep-input[type=number] { -moz-appearance: textfield; }

  .ep-nav__arrows { display: flex; gap: var(--space-2); }

  /* Sidebar */
  .watch-sidebar {
    background: var(--clr-bg-2);
    border: 1px solid var(--clr-border);
    border-radius: var(--radius-xl);
    overflow: hidden;
    position: sticky;
    top: calc(var(--navbar-h) + var(--space-4));
  }

  .watch-sidebar__title {
    font-size: var(--text-sm);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--clr-text-muted);
    padding: var(--space-4) var(--space-5);
    border-bottom: 1px solid var(--clr-border);
  }

  .watch-sidebar__list {
    display: flex;
    flex-direction: column;
    max-height: 600px;
    overflow-y: auto;
    scrollbar-width: thin;
  }

  .sidebar-card {
    display: flex;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    text-decoration: none;
    color: inherit;
    transition: background var(--transition-fast);
    border-bottom: 1px solid var(--clr-border);
  }

  .sidebar-card:last-child { border-bottom: none; }
  .sidebar-card:hover { background: var(--clr-bg-elevated); }

  .sidebar-card__poster {
    position: relative;
    width: 56px;
    flex-shrink: 0;
    border-radius: var(--radius-md);
    overflow: hidden;
    aspect-ratio: 2/3;
    background: var(--clr-bg-card);
  }

  .sidebar-card__poster img { width: 100%; height: 100%; object-fit: cover; display: block; }

  .sidebar-card__rating {
    position: absolute;
    bottom: 2px;
    left: 2px;
    font-size: 9px;
    font-weight: 700;
    padding: 1px 4px;
    border-radius: 3px;
    background: rgba(10,10,15,0.85);
  }

  .sidebar-card__info { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2px; }

  .sidebar-card__title {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--clr-text);
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .sidebar-card:hover .sidebar-card__title { color: var(--clr-accent); }
  .sidebar-card__year { font-size: var(--text-xs); color: var(--clr-text-muted); }

  .sidebar-card__overview {
    font-size: var(--text-xs);
    color: var(--clr-text-muted);
    line-height: 1.5;
    margin-top: 2px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .watch-body { grid-template-columns: 1fr 300px; }
  }

  @media (max-width: 768px) {
    .watch-player-wrap { position: static; height: 56.25vw; }
    .watch-player { max-height: none; }
    .watch-body { grid-template-columns: 1fr; }
    .watch-sidebar { position: static; }
    .watch-sidebar__list { max-height: 480px; }
    .watch-info__poster { width: 72px; }
    .ep-nav__controls { flex-direction: column; align-items: flex-start; }
  }
</style>
