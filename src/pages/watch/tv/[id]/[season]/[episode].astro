---
export const prerender = false;

import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import {
  getTVDetails,
  getTVRecommendations,
  getSeasonEpisodes,
  imgUrl,
  formatRating,
  formatYear,
  ratingColor,
} from '../../../../../lib/tmdb';

const { id, season, episode } = Astro.params;
const showId   = Number(id);
const seasonN  = Math.max(1, Number(season)  || 1);
const episodeN = Math.max(1, Number(episode) || 1);

if (!id || isNaN(showId)) return Astro.redirect('/404');

let show, recommendations, seasonData;
try {
  [show, recommendations, seasonData] = await Promise.all([
    getTVDetails(showId),
    getTVRecommendations(showId),
    getSeasonEpisodes(showId, seasonN),
  ]);
} catch {
  return Astro.redirect('/404');
}

const recs          = recommendations.results.slice(0, 12);
const episodes      = seasonData.episodes ?? [];
const rating        = formatRating(show.vote_average);
const rClass        = ratingColor(show.vote_average);
const year          = formatYear(show.first_air_date);
const poster        = imgUrl(show.poster_path, 'w300');
const totalSeasons  = show.number_of_seasons ?? 1;

const embedUrl = `https://embed.flixworld.xyz/embed/tv/${showId}/${seasonN}/${episodeN}`;
---

<BaseLayout
  title={`Watch ${show.name} S${seasonN}E${episodeN}`}
  description={`Stream ${show.name} Season ${seasonN} Episode ${episodeN} on StreamVault.`}
  image={imgUrl(show.backdrop_path, 'w780')}
>
  <div class="watch-page">

    <!-- ── Top row: player + sidebar ── -->
    <div class="watch-top container">

      <!-- Player -->
      <div class="watch-player-wrap">
        <div class="watch-player">
          <iframe
            id="player-iframe"
            src={embedUrl}
            title={`Watch ${show.name} S${seasonN}E${episodeN}`}
            allow="autoplay; encrypted-media; fullscreen; picture-in-picture"
            allowfullscreen
            class="watch-player__iframe"
            loading="eager"
          ></iframe>
        </div>
      </div>

      <!-- Sidebar: tabbed (Episodes / More Like This) -->
      <aside class="watch-sidebar" aria-label="Sidebar">

        <!-- Tab bar -->
        <div class="sidebar-tabs" role="tablist">
          <button
            class="sidebar-tab sidebar-tab--active"
            role="tab"
            aria-selected="true"
            aria-controls="tab-episodes"
            id="btn-episodes"
            data-tab="episodes"
          >Episodes</button>
          <button
            class="sidebar-tab"
            role="tab"
            aria-selected="false"
            aria-controls="tab-more"
            id="btn-more"
            data-tab="more"
          >More Like This</button>
        </div>

        <!-- Tab: Episodes -->
        <div
          class="sidebar-panel"
          id="tab-episodes"
          role="tabpanel"
          aria-labelledby="btn-episodes"
        >
          <!-- Season selector -->
          <div class="season-select-wrap">
            <label class="season-label" for="season-select">Season</label>
            <select id="season-select" class="season-select" aria-label="Select season">
              {Array.from({ length: totalSeasons }, (_, i) => i + 1).map(s => (
                <option value={s} selected={s === seasonN}>{s}</option>
              ))}
            </select>
          </div>

          <!-- Episode list -->
          <ul class="ep-list" role="list">
            {episodes.map(ep => {
              const isActive = ep.episode_number === episodeN;
              const epUrl    = `/watch/tv/${showId}/${seasonN}/${ep.episode_number}`;
              const still    = ep.still_path
                ? imgUrl(ep.still_path, 'w185')
                : '/placeholder-backdrop.svg';

              return (
                <li>
                  <a
                    href={epUrl}
                    class={`ep-card${isActive ? ' ep-card--active' : ''}`}
                    aria-current={isActive ? 'page' : undefined}
                  >
                    <div class="ep-card__still">
                      <img
                        src={still}
                        alt=""
                        aria-hidden="true"
                        width="185" height="104"
                        loading="lazy" decoding="async"
                      />
                      {isActive && (
                        <span class="ep-card__now-playing" aria-label="Now playing">
                          <svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                            <path d="M8 5.14v14l11-7-11-7z"/>
                          </svg>
                        </span>
                      )}
                    </div>
                    <div class="ep-card__info">
                      <p class="ep-card__num">E{ep.episode_number}</p>
                      <p class="ep-card__title">{ep.name}</p>
                      {ep.runtime && <p class="ep-card__runtime">{ep.runtime}m</p>}
                    </div>
                  </a>
                </li>
              );
            })}
          </ul>
        </div>

        <!-- Tab: More Like This -->
        <div
          class="sidebar-panel sidebar-panel--hidden"
          id="tab-more"
          role="tabpanel"
          aria-labelledby="btn-more"
        >
          {recs.length > 0 ? (
            <ul class="rec-list" role="list">
              {recs.map(item => {
                const recRating = formatRating(item.vote_average);
                const recClass  = ratingColor(item.vote_average);
                const recYear   = formatYear(item.first_air_date);
                return (
                  <li>
                    <a href={`/watch/tv/${item.id}/1/1`} class="sidebar-card">
                      <div class="sidebar-card__poster">
                        <img
                          src={imgUrl(item.poster_path, 'w185')}
                          alt={item.name}
                          width="185" height="278"
                          loading="lazy" decoding="async"
                        />
                        <span class={`sidebar-card__rating ${recClass}`}>★ {recRating}</span>
                      </div>
                      <div class="sidebar-card__info">
                        <p class="sidebar-card__title">{item.name}</p>
                        <p class="sidebar-card__year">{recYear}</p>
                        <p class="sidebar-card__overview">{item.overview}</p>
                      </div>
                    </a>
                  </li>
                );
              })}
            </ul>
          ) : (
            <p class="sidebar-empty">No recommendations found.</p>
          )}
        </div>

      </aside>
    </div>

    <!-- ── Bottom: show info ── -->
    <div class="watch-info-wrap container">

      <nav class="watch-breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">›</span>
        <a href="/tv">TV Shows</a>
        <span aria-hidden="true">›</span>
        <a href={`/tv/${show.id}`}>{show.name}</a>
        <span aria-hidden="true">›</span>
        <span aria-current="page">S{seasonN} · E{episodeN}</span>
      </nav>

      <div class="watch-info">
        <img
          src={poster}
          alt={`${show.name} poster`}
          width="300" height="450"
          loading="lazy" decoding="async"
          class="watch-info__poster"
        />
        <div class="watch-info__text">
          <h1 class="watch-info__title">
            {show.name}
            <span class="watch-info__year">({year})</span>
          </h1>
          <p class="watch-info__ep-label">Season {seasonN} · Episode {episodeN}</p>
          <div class="watch-info__meta">
            <span class={`watch-info__rating ${rClass}`}>
              <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
              </svg>
              {rating}
            </span>
            {show.genres && show.genres.length > 0 && (
              <>
                <span class="dot" aria-hidden="true">·</span>
                <span>{show.genres.slice(0, 3).map(g => g.name).join(', ')}</span>
              </>
            )}
          </div>
          {show.overview && <p class="watch-info__overview">{show.overview}</p>}
          <div class="watch-info__actions">
            <a href={`/tv/${show.id}`} class="btn btn--ghost">← Back to Details</a>
            {episodeN > 1 && (
              <a
                href={`/watch/tv/${showId}/${seasonN}/${episodeN - 1}`}
                class="btn btn--ghost"
              >← Prev Episode</a>
            )}
            <a
              href={`/watch/tv/${showId}/${seasonN}/${episodeN + 1}`}
              class="btn btn--primary"
            >Next Episode →</a>
          </div>
        </div>
      </div>

    </div>
  </div>
</BaseLayout>

<!-- ── Scripts ── -->
<script define:vars={{ showId, seasonN, episodeN }}>
  // ── Tab switching ──────────────────────────────────────────
  const tabs    = document.querySelectorAll('.sidebar-tab');
  const panels  = document.querySelectorAll('.sidebar-panel');

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const target = tab.dataset.tab;

      tabs.forEach(t => {
        t.classList.toggle('sidebar-tab--active', t === tab);
        t.setAttribute('aria-selected', String(t === tab));
      });

      panels.forEach(panel => {
        panel.classList.toggle('sidebar-panel--hidden', panel.id !== `tab-${target}`);
      });
    });
  });

  // ── Season select → navigate ───────────────────────────────
  document.getElementById('season-select')?.addEventListener('change', e => {
    const s = e.target.value;
    window.location.href = `/watch/tv/${showId}/${s}/1`;
  });

  // ── Scroll active episode into view ───────────────────────
  const activeEp = document.querySelector('.ep-card--active');
  if (activeEp) {
    activeEp.scrollIntoView({ block: 'nearest', behavior: 'instant' });
  }

  // ── Sync sidebar height to player ─────────────────────────
  function syncSidebarHeight() {
    const player  = document.querySelector('.watch-player-wrap');
    const sidebar = document.querySelector('.watch-sidebar');
    if (!player || !sidebar) return;

    if (window.innerWidth <= 768) {
      sidebar.style.removeProperty('--player-h');
      return;
    }

    const h = player.getBoundingClientRect().height;
    if (h > 0) sidebar.style.setProperty('--player-h', h + 'px');
  }

  syncSidebarHeight();
  window.addEventListener('load',   syncSidebarHeight);
  window.addEventListener('resize', syncSidebarHeight);
</script>

<style>
  /* ── Page ───────────────────────────────────────────────── */
  .watch-page {
    background: #000;
    padding-top: var(--navbar-h);
    padding-bottom: var(--space-16);
  }

  /* ── Top row ────────────────────────────────────────────── */
  .watch-top {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: var(--space-4);
    align-items: start;
    padding-top: var(--space-4);
  }

  /* ── Player ─────────────────────────────────────────────── */
  .watch-player-wrap {
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #000;
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .watch-player { width: 100%; height: 100%; }

  .watch-player__iframe {
    width: 100%;
    height: 100%;
    border: none;
    display: block;
  }

  /* ── Sidebar shell ───────────────────────────────────────── */
  .watch-sidebar {
    height: var(--player-h, 400px);
    display: flex;
    flex-direction: column;
    background: var(--clr-bg-2);
    border: 1px solid var(--clr-border);
    border-radius: var(--radius-xl);
    overflow: hidden;
  }

  /* ── Tab bar ─────────────────────────────────────────────── */
  .sidebar-tabs {
    display: flex;
    flex-shrink: 0;
    border-bottom: 1px solid var(--clr-border);
  }

  .sidebar-tab {
    flex: 1;
    padding: var(--space-3) var(--space-4);
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    color: var(--clr-text-muted);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    cursor: pointer;
    transition: color var(--transition-fast), border-color var(--transition-fast);
    margin-bottom: -1px; /* sit on top of the container border */
  }

  .sidebar-tab:hover { color: var(--clr-text-secondary); }

  .sidebar-tab--active {
    color: var(--clr-text);
    border-bottom-color: var(--clr-accent);
  }

  /* ── Panels ──────────────────────────────────────────────── */
  .sidebar-panel {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    overflow: hidden; /* children handle their own scroll */
  }

  .sidebar-panel--hidden { display: none; }

  /* ── Season selector (inside Episodes panel) ────────────── */
  .season-select-wrap {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--clr-border);
  }

  .season-label {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--clr-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    white-space: nowrap;
  }

  .season-select {
    flex: 1;
    background: var(--clr-bg-elevated);
    border: 1px solid var(--clr-border-strong);
    border-radius: var(--radius-md);
    color: var(--clr-text);
    font-size: var(--text-sm);
    font-weight: 600;
    padding: var(--space-2) var(--space-3);
    cursor: pointer;
  }

  .season-select:focus {
    outline: none;
    border-color: var(--clr-accent);
    box-shadow: 0 0 0 3px var(--clr-accent-muted);
  }

  /* ── Episode list ────────────────────────────────────────── */
  .ep-list {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    scrollbar-width: thin;
  }

  .ep-card {
    display: flex;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-3);
    text-decoration: none;
    color: inherit;
    border-bottom: 1px solid var(--clr-border);
    transition: background var(--transition-fast);
  }

  .ep-card:last-child { border-bottom: none; }
  .ep-card:hover      { background: var(--clr-bg-elevated); }

  .ep-card--active {
    background: var(--clr-accent-muted);
    border-left: 2px solid var(--clr-accent);
  }

  .ep-card--active:hover { background: var(--clr-accent-muted); }

  .ep-card__still {
    position: relative;
    width: 80px;
    flex-shrink: 0;
    border-radius: var(--radius-sm);
    overflow: hidden;
    aspect-ratio: 16/9;
    background: var(--clr-bg-card);
  }

  .ep-card__still img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Play icon badge on active episode */
  .ep-card__now-playing {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(229, 9, 20, 0.75);
    color: #fff;
  }

  .ep-card__info {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 2px;
  }

  .ep-card__num {
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--clr-accent);
  }

  .ep-card__title {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--clr-text);
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .ep-card--active .ep-card__title { color: #fff; }

  .ep-card__runtime {
    font-size: var(--text-xs);
    color: var(--clr-text-muted);
  }

  /* ── Recommendations list ────────────────────────────────── */
  .rec-list {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    scrollbar-width: thin;
  }

  .sidebar-card {
    display: flex;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    text-decoration: none;
    color: inherit;
    transition: background var(--transition-fast);
    border-bottom: 1px solid var(--clr-border);
  }

  .sidebar-card:last-child { border-bottom: none; }
  .sidebar-card:hover      { background: var(--clr-bg-elevated); }

  .sidebar-card__poster {
    position: relative;
    width: 48px;
    flex-shrink: 0;
    border-radius: var(--radius-md);
    overflow: hidden;
    aspect-ratio: 2/3;
    background: var(--clr-bg-card);
  }

  .sidebar-card__poster img { width: 100%; height: 100%; object-fit: cover; display: block; }

  .sidebar-card__rating {
    position: absolute;
    bottom: 2px;
    left: 2px;
    font-size: 9px;
    font-weight: 700;
    padding: 1px 4px;
    border-radius: 3px;
    background: rgba(10,10,15,0.85);
  }

  .sidebar-card__info {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .sidebar-card__title {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--clr-text);
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .sidebar-card:hover .sidebar-card__title { color: var(--clr-accent); }
  .sidebar-card__year { font-size: var(--text-xs); color: var(--clr-text-muted); }

  .sidebar-card__overview {
    font-size: var(--text-xs);
    color: var(--clr-text-muted);
    line-height: 1.5;
    margin-top: 2px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .sidebar-empty {
    padding: var(--space-6) var(--space-4);
    font-size: var(--text-sm);
    color: var(--clr-text-muted);
    text-align: center;
  }

  /* ── Show info below player ──────────────────────────────── */
  .watch-info-wrap {
    padding-top: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .watch-breadcrumb {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--clr-text-muted);
    flex-wrap: wrap;
  }

  .watch-breadcrumb a { color: var(--clr-text-secondary); transition: color var(--transition-fast); }
  .watch-breadcrumb a:hover { color: var(--clr-accent); }

  .watch-info {
    display: flex;
    gap: var(--space-6);
    align-items: flex-start;
    background: var(--clr-bg-card);
    border: 1px solid var(--clr-border);
    border-radius: var(--radius-xl);
    padding: var(--space-6);
  }

  .watch-info__poster {
    width: 100px;
    flex-shrink: 0;
    border-radius: var(--radius-lg);
    object-fit: cover;
    height: auto;
    box-shadow: var(--shadow-md);
  }

  .watch-info__text {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .watch-info__title {
    font-family: var(--font-display);
    font-size: clamp(var(--text-2xl), 3vw, var(--text-4xl));
    letter-spacing: 0.02em;
    line-height: 1.1;
    color: var(--clr-text);
  }

  .watch-info__year { color: var(--clr-text-muted); font-size: 0.7em; margin-left: var(--space-2); }

  .watch-info__ep-label {
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--clr-accent);
  }

  .watch-info__meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
    font-size: var(--text-sm);
    color: var(--clr-text-secondary);
  }

  .watch-info__rating {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-weight: 700;
  }

  .dot { color: var(--clr-text-muted); }

  .watch-info__overview {
    font-size: var(--text-sm);
    color: var(--clr-text-secondary);
    line-height: 1.7;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .watch-info__actions { display: flex; gap: var(--space-3); flex-wrap: wrap; }

  /* ── Responsive ─────────────────────────────────────────── */
  @media (max-width: 1024px) {
    .watch-top { grid-template-columns: 1fr 280px; }
  }

  @media (max-width: 768px) {
    .watch-top {
      grid-template-columns: 1fr;
      padding-top: var(--space-3);
    }

    .watch-sidebar { height: 480px; }

    .watch-info { padding: var(--space-4); }
    .watch-info__poster { width: 72px; }
  }
</style>
