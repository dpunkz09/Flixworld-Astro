---
export const prerender = false;

import BaseLayout from '../../../layouts/BaseLayout.astro';
import {
  getMovieDetails,
  getMovieRecommendations,
  imgUrl,
  formatRating,
  formatRuntime,
  formatYear,
  ratingColor,
} from '../../../lib/tmdb';
import { parseSlugId, moviePath, watchMoviePath } from '../../../lib/slugify';

const { slug } = Astro.params;
const movieId = parseSlugId(slug ?? '');
if (!slug || isNaN(movieId)) return Astro.redirect('/404');

let movie, recommendations;
try {
  [movie, recommendations] = await Promise.all([
    getMovieDetails(movieId),
    getMovieRecommendations(movieId),
  ]);
} catch {
  return Astro.redirect('/404');
}

const recs     = recommendations.results.slice(0, 12);
const rating   = formatRating(movie.vote_average);
const rClass   = ratingColor(movie.vote_average);
const year     = formatYear(movie.release_date);
const runtime  = formatRuntime(movie.runtime ?? 0);
const poster   = imgUrl(movie.poster_path, 'w300');
const embedUrl = `https://embed.flixworld.xyz/embed/movie/${movieId}`;

// Redirect bare numeric slugs to canonical slug URL
const canonicalSlug = watchMoviePath(movie.title, year, movieId).replace('/watch/movie/', '');
if (slug !== canonicalSlug) {
  return Astro.redirect(watchMoviePath(movie.title, year, movieId), 301);
}

const watchHistoryEntry = {
  id:         movieId,
  type:       'movie' as const,
  title:      movie.title,
  year,
  posterPath: movie.poster_path ?? null,
  href:       watchMoviePath(movie.title, year, movieId),
};

const detailPath = moviePath(movie.title, year, movieId);
---

<BaseLayout
  title={`Watch ${movie.title} (${year})`}
  description={`Stream ${movie.title} online on Flixworld.`}
  image={imgUrl(movie.backdrop_path, 'w780')}
>
  <div class="watch-page">

    <!-- ── Top row: player + sidebar ── -->
    <div class="watch-top container">

      <!-- Player -->
      <div class="watch-player-wrap">
        <div class="watch-player">
          <iframe
            src={embedUrl}
            title={`Watch ${movie.title}`}
            allow="autoplay; encrypted-media; fullscreen; picture-in-picture"
            allowfullscreen
            class="watch-player__iframe"
            loading="eager"
          ></iframe>
        </div>
      </div>

      <!-- Sidebar: recommendations -->
      {recs.length > 0 && (
        <aside class="watch-sidebar" aria-label="More like this">
          <h2 class="watch-sidebar__title">More Like This</h2>
          <ul class="watch-sidebar__list" role="list">
            {recs.map(item => {
              const recRating = formatRating(item.vote_average);
              const recClass  = ratingColor(item.vote_average);
              const recYear   = formatYear(item.release_date);
              return (
                <li>
                  <a href={watchMoviePath(item.title, formatYear(item.release_date), item.id)} class="sidebar-card">
                    <div class="sidebar-card__poster">
                      <img
                        src={imgUrl(item.poster_path, 'w185')}
                        alt={item.title}
                        width="185" height="278"
                        loading="lazy" decoding="async"
                      />
                      <span class={`sidebar-card__rating ${recClass}`}>★ {recRating}</span>
                    </div>
                    <div class="sidebar-card__info">
                      <p class="sidebar-card__title">{item.title}</p>
                      <p class="sidebar-card__year">{recYear}</p>
                      <p class="sidebar-card__overview">{item.overview}</p>
                    </div>
                  </a>
                </li>
              );
            })}
          </ul>
        </aside>
      )}
    </div>

    <!-- ── Bottom: movie info ── -->
    <div class="watch-info-wrap container">

      <!-- Breadcrumb -->
      <nav class="watch-breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">›</span>
        <a href="/movies">Movies</a>
        <span aria-hidden="true">›</span>
        <a href={`/movie/${movie.id}`}>{movie.title}</a>
        <span aria-hidden="true">›</span>
        <span aria-current="page">Watch</span>
      </nav>

      <div class="watch-info">
        <img
          src={poster}
          alt={`${movie.title} poster`}
          width="300" height="450"
          loading="lazy" decoding="async"
          class="watch-info__poster"
        />
        <div class="watch-info__text">
          <h1 class="watch-info__title">
            {movie.title}
            <span class="watch-info__year">({year})</span>
          </h1>
          <div class="watch-info__meta">
            <span class={`watch-info__rating ${rClass}`}>
              <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
              </svg>
              {rating}
            </span>
            <span class="dot" aria-hidden="true">·</span>
            <span>{runtime}</span>
            {movie.genres && movie.genres.length > 0 && (
              <>
                <span class="dot" aria-hidden="true">·</span>
                <span>{movie.genres.slice(0, 3).map(g => g.name).join(', ')}</span>
              </>
            )}
          </div>
          {movie.overview && <p class="watch-info__overview">{movie.overview}</p>}
          <div class="watch-info__actions">
            <a href={detailPath} class="btn btn--ghost">← Back to Details</a>
          </div>
        </div>
      </div>

    </div>
  </div>
</BaseLayout>

<script define:vars={{ __wh: watchHistoryEntry }}>
  // ── Watch history ──────────────────────────────────────────
  // Record this movie immediately so it appears in Continue Watching
  // on the homepage. Data is passed in via define:vars from the server.
  (function () {
    const entry = {
      id:         __wh.id,
      type:       'movie',
      title:      __wh.title,
      year:       __wh.year,
      posterPath: __wh.posterPath,
      href:       __wh.href,
    };

    try {
      const STORAGE_KEY = 'fw:watch-history';
      const MAX_ITEMS   = 20;
      const raw    = localStorage.getItem(STORAGE_KEY);
      const list   = raw ? JSON.parse(raw) : [];
      const pruned = list.filter((e) => !(e.id === entry.id && e.type === entry.type));
      pruned.unshift({ ...entry, watchedAt: Date.now() });
      localStorage.setItem(STORAGE_KEY, JSON.stringify(pruned.slice(0, MAX_ITEMS)));
    } catch { /* private browsing or quota */ }
  })();
</script>

<style>
  /* ── Page shell ─────────────────────────────────────────── */
  .watch-page {
    background: #000;
    padding-top: var(--navbar-h);
    padding-bottom: var(--space-16);
  }

  /* ── Top row: player + sidebar side-by-side ────────────── */
  .watch-top {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: var(--space-4);
    align-items: start;
    padding-top: var(--space-4);
  }

  /* ── Player ─────────────────────────────────────────────── */
  .watch-player-wrap {
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #000;
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .watch-player {
    width: 100%;
    height: 100%;
  }

  .watch-player__iframe {
    width: 100%;
    height: 100%;
    border: none;
    display: block;
  }

  /* ── Sidebar ─────────────────────────────────────────────── */
  .watch-sidebar {
    /* height is set by JS to match the player exactly */
    height: var(--player-h, 400px);
    display: flex;
    flex-direction: column;
    background: var(--clr-bg-2);
    border: 1px solid var(--clr-border);
    border-radius: var(--radius-xl);
    overflow: hidden;
  }

  .watch-sidebar__title {
    flex-shrink: 0;
    font-size: var(--text-sm);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--clr-text-muted);
    padding: var(--space-4) var(--space-5);
    border-bottom: 1px solid var(--clr-border);
  }

  /* List fills all remaining height and scrolls within it */
  .watch-sidebar__list {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    scrollbar-width: thin;
  }

  /* ── Sidebar cards ───────────────────────────────────────── */
  .sidebar-card {
    display: flex;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    text-decoration: none;
    color: inherit;
    transition: background var(--transition-fast);
    border-bottom: 1px solid var(--clr-border);
  }

  .sidebar-card:last-child { border-bottom: none; }
  .sidebar-card:hover      { background: var(--clr-bg-elevated); }

  .sidebar-card__poster {
    position: relative;
    width: 48px;
    flex-shrink: 0;
    border-radius: var(--radius-md);
    overflow: hidden;
    aspect-ratio: 2/3;
    background: var(--clr-bg-card);
  }

  .sidebar-card__poster img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .sidebar-card__rating {
    position: absolute;
    bottom: 2px;
    left: 2px;
    font-size: 9px;
    font-weight: 700;
    padding: 1px 4px;
    border-radius: 3px;
    background: rgba(10,10,15,0.85);
  }

  .sidebar-card__info {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .sidebar-card__title {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--clr-text);
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .sidebar-card:hover .sidebar-card__title { color: var(--clr-accent); }

  .sidebar-card__year {
    font-size: var(--text-xs);
    color: var(--clr-text-muted);
  }

  .sidebar-card__overview {
    font-size: var(--text-xs);
    color: var(--clr-text-muted);
    line-height: 1.5;
    margin-top: 2px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ── Movie info below the player ────────────────────────── */
  .watch-info-wrap {
    padding-top: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .watch-breadcrumb {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--clr-text-muted);
    flex-wrap: wrap;
  }

  .watch-breadcrumb a {
    color: var(--clr-text-secondary);
    transition: color var(--transition-fast);
  }

  .watch-breadcrumb a:hover { color: var(--clr-accent); }

  .watch-info {
    display: flex;
    gap: var(--space-6);
    align-items: flex-start;
    background: var(--clr-bg-card);
    border: 1px solid var(--clr-border);
    border-radius: var(--radius-xl);
    padding: var(--space-6);
  }

  .watch-info__poster {
    width: 100px;
    flex-shrink: 0;
    border-radius: var(--radius-lg);
    object-fit: cover;
    height: auto;
    box-shadow: var(--shadow-md);
  }

  .watch-info__text {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .watch-info__title {
    font-family: var(--font-display);
    font-size: clamp(var(--text-2xl), 3vw, var(--text-4xl));
    letter-spacing: 0.02em;
    line-height: 1.1;
    color: var(--clr-text);
  }

  .watch-info__year {
    color: var(--clr-text-muted);
    font-size: 0.7em;
    margin-left: var(--space-2);
  }

  .watch-info__meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
    font-size: var(--text-sm);
    color: var(--clr-text-secondary);
  }

  .watch-info__rating {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-weight: 700;
  }

  .dot { color: var(--clr-text-muted); }

  .watch-info__overview {
    font-size: var(--text-sm);
    color: var(--clr-text-secondary);
    line-height: 1.7;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .watch-info__actions {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  @media (max-width: 1024px) {
    .watch-top { grid-template-columns: 1fr 280px; }
  }

  @media (max-width: 768px) {
    .watch-top {
      grid-template-columns: 1fr;
      padding-top: var(--space-3);
    }

    /* On mobile sidebar is below the player — fixed height, scroll inside */
    .watch-sidebar {
      height: 420px;
    }

    .watch-info { padding: var(--space-4); gap: var(--space-4); }
    .watch-info__poster { width: 72px; }
  }

  @media (max-width: 480px) {
    .watch-info {
      flex-direction: column;
      align-items: flex-start;
    }

    .watch-info__poster { width: 80px; }

    /* Stack action buttons full-width on small phones */
    .watch-info__actions {
      flex-direction: column;
    }

    .watch-info__actions .btn {
      width: 100%;
      justify-content: center;
    }

    .watch-page {
      padding-bottom: calc(var(--space-16) + 56px);
    }
  }
</style>

<script>
  // Use ResizeObserver on the player element — fires only when the player
  // actually changes size, not on every window resize event.
  // Stored on the element itself so it can be disconnected on navigation.
  const player  = document.querySelector<HTMLElement>('.watch-player-wrap');
  const sidebar = document.querySelector<HTMLElement>('.watch-sidebar');

  let ro: ResizeObserver | null = null;

  function syncHeight(playerEl: HTMLElement, sidebarEl: HTMLElement) {
    if (window.innerWidth <= 768) {
      sidebarEl.style.removeProperty('--player-h');
      return;
    }
    const h = playerEl.getBoundingClientRect().height;
    if (h > 0) sidebarEl.style.setProperty('--player-h', `${h}px`);
  }

  if (player && sidebar) {
    syncHeight(player, sidebar);

    ro = new ResizeObserver(() => syncHeight(player, sidebar));
    ro.observe(player);
  }

  // Clean up on view-transition navigation
  document.addEventListener('astro:before-swap', () => {
    ro?.disconnect();
    ro = null;
  }, { once: true });
</script>
