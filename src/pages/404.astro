---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found | Flixworld"
  description="The page you are looking for could not be found."
>
  <div class="not-found">
    <div class="not-found__inner container">
      <!-- Animated film strip decoration -->
      <div class="not-found__film" aria-hidden="true">
        <div class="film-strip">
          {Array.from({ length: 6 }).map(() => (
            <div class="film-frame"></div>
          ))}
        </div>
      </div>

      <div class="not-found__content">
        <p class="not-found__code" aria-hidden="true">404</p>
        <h1 class="not-found__title">Scene Not Found</h1>
        <p class="not-found__desc">
          Looks like this scene got cut from the final edit.
          The page you're looking for doesn't exist or has moved.
        </p>

        <div class="not-found__actions">
          <a href="/" class="btn btn--primary btn--lg">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
              <polyline points="9,22 9,12 15,12 15,22"/>
            </svg>
            Go Home
          </a>
          <a href="/movies" class="btn btn--secondary btn--lg">Browse Movies</a>
          <a href="/tv" class="btn btn--ghost btn--lg">Browse TV Shows</a>
        </div>

        <div class="not-found__search">
          <p>Or search for something specific:</p>
          <form action="/search" method="get" class="not-found__form" role="search">
            <label for="not-found-search" class="sr-only">Search</label>
            <input
              id="not-found-search"
              type="search"
              name="q"
              placeholder="e.g. Inception, Breaking Bad..."
              class="not-found__input"
              autocomplete="off"
            />
            <button type="submit" class="btn btn--primary" aria-label="Search">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <circle cx="11" cy="11" r="8"/>
                <path d="m21 21-4.35-4.35"/>
              </svg>
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .not-found {
    min-height: calc(100dvh - var(--navbar-h));
    display: flex;
    align-items: center;
    padding-top: var(--navbar-h);
    background:
      radial-gradient(ellipse at 50% 0%, rgba(229,9,20,0.06) 0%, transparent 60%),
      var(--clr-bg);
  }

  .not-found__inner {
    display: flex;
    align-items: center;
    gap: var(--space-16);
    padding-block: var(--space-16);
    flex-wrap: wrap;
    justify-content: center;
  }

  /* Film strip decoration */
  .not-found__film {
    flex-shrink: 0;
  }

  .film-strip {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    opacity: 0.15;
  }

  .film-frame {
    width: 80px;
    height: 60px;
    border-radius: var(--radius-sm);
    border: 3px solid var(--clr-text-muted);
    position: relative;
  }

  .film-frame::before,
  .film-frame::after {
    content: '';
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 10px;
    height: 30px;
    background: var(--clr-text-muted);
    border-radius: 2px;
  }

  .film-frame::before { left: -16px; }
  .film-frame::after  { right: -16px; }

  /* Content */
  .not-found__content {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    max-width: 520px;
  }

  .not-found__code {
    font-family: var(--font-display);
    font-size: clamp(6rem, 15vw, 10rem);
    line-height: 0.9;
    color: var(--clr-accent);
    opacity: 0.15;
    letter-spacing: -0.02em;
    user-select: none;
    margin-bottom: calc(var(--space-2) * -1);
  }

  .not-found__title {
    font-family: var(--font-display);
    font-size: clamp(var(--text-3xl), 5vw, var(--text-5xl));
    letter-spacing: 0.02em;
    color: var(--clr-text);
  }

  .not-found__desc {
    font-size: var(--text-base);
    color: var(--clr-text-secondary);
    line-height: 1.7;
  }

  .not-found__actions {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  /* Inline search */
  .not-found__search {
    padding-top: var(--space-4);
    border-top: 1px solid var(--clr-border);
  }

  .not-found__search p {
    font-size: var(--text-sm);
    color: var(--clr-text-muted);
    margin-bottom: var(--space-3);
  }

  .not-found__form {
    display: flex;
    gap: var(--space-2);
    max-width: 400px;
  }

  .not-found__input {
    flex: 1;
    background: var(--clr-bg-elevated);
    border: 1px solid var(--clr-border-strong);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
    color: var(--clr-text);
    font-size: var(--text-sm);
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .not-found__input::placeholder { color: var(--clr-text-muted); }

  .not-found__input:focus {
    outline: none;
    border-color: var(--clr-accent);
    box-shadow: 0 0 0 3px var(--clr-accent-muted);
  }

  /* Remove WebKit search cancel */
  .not-found__input::-webkit-search-cancel-button { -webkit-appearance: none; }

  @media (max-width: 640px) {
    .not-found__film { display: none; }
  }
</style>
