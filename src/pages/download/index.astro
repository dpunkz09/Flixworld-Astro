---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import { imgUrl } from '../../lib/tmdb';

const params  = Astro.url.searchParams;
const type    = params.get('type') ?? '';
const id      = params.get('id') ?? '';
const title   = params.get('title') ?? 'Unknown Title';
const poster  = params.get('poster') ?? null;
const season  = params.get('season') ?? '1';
const episode = params.get('episode') ?? '1';
const year    = params.get('year') ?? '';

if (!type || !id || isNaN(Number(id))) {
  return Astro.redirect('/404');
}

const posterUrl = poster ? imgUrl(poster, 'w300') : '/placeholder-poster.svg';
const isTv      = type === 'tv';
const backHref  = isTv ? `/tv` : `/movies`;
const COUNTDOWN = 15;
---

<BaseLayout
  title={`Download ${title}${isTv ? ` S${season}E${episode}` : ''} — Flixworld`}
  description={`Download ${title} for free on Flixworld.`}
>
  <!-- ── Popunder: fires on page load, invisible ── -->
  <script src="https://pl31179950.profitableratecpmnetwork.com/8e/71/13/8e7113ff3c44c89f810b517bbb3a349e.js"></script>

  <div class="dl-page">

    <!-- ── Top native banner (full width, high visibility) ── -->
    <div class="dl-native-top">
      <script async="async" data-cfasync="false" src="https://pl31179952.profitableratecpmnetwork.com/3660d37311472ae17c69dda162f6f3e8/invoke.js"></script>
      <div id="container-3660d37311472ae17c69dda162f6f3e8"></div>
    </div>

    <div class="container">

      <!-- Back link -->
      <nav class="dl-back" aria-label="Back">
        <a href={backHref} class="dl-back__link">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="15,18 9,12 15,6"/>
          </svg>
          Back
        </a>
      </nav>

      <!-- ── Main card: horizontal on desktop ── -->
      <div class="dl-card">

        <!-- Poster -->
        <div class="dl-card__poster">
          <img
            src={posterUrl}
            alt={`${title} poster`}
            width="300"
            height="450"
            loading="eager"
            decoding="async"
          />
        </div>

        <!-- Body -->
        <div class="dl-card__body">

          <div class="dl-card__meta">
            <span class="dl-card__type-pill">{isTv ? 'Series' : 'Movie'}</span>
            {year && <span class="dl-card__year">{year}</span>}
          </div>

          <h1 class="dl-card__title">
            {title}
            {isTv && <span class="dl-card__ep">Season {season} · Episode {episode}</span>}
          </h1>

          <p class="dl-card__hint">Your download will be ready after a short wait. Please keep this page open.</p>

          <!-- ── Countdown ── -->
          <div class="dl-countdown" id="dl-countdown">
            <div class="dl-countdown__bar-wrap"
              role="progressbar"
              aria-valuemin="0"
              aria-valuemax={COUNTDOWN}
              aria-valuenow="0"
              id="dl-progress"
              aria-label="Ad countdown">
              <div class="dl-countdown__bar" id="dl-bar"></div>
            </div>
            <p class="dl-countdown__label">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <circle cx="12" cy="12" r="10"/>
                <polyline points="12,6 12,12 16,14"/>
              </svg>
              Download unlocks in <strong id="dl-secs">{COUNTDOWN}</strong>s
            </p>
          </div>

          <!-- ── Actions ── -->
          <div class="dl-actions" id="dl-actions" aria-live="polite">
            <div class="dl-status" id="dl-status">
              <span class="dl-spinner" aria-hidden="true"></span>
              <span id="dl-status-text">Preparing your download…</span>
            </div>

            <a
              href="#"
              class="btn btn--primary btn--lg dl-btn"
              id="dl-btn"
              target="_blank"
              rel="noopener noreferrer"
              aria-disabled="true"
              tabindex="-1"
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                <polyline points="7,10 12,15 17,10"/>
                <line x1="12" y1="15" x2="12" y2="3"/>
              </svg>
              Download Now
            </a>

            <p class="dl-disclaimer">For personal offline viewing only.</p>
          </div>

        </div>
      </div>

      <!-- ── Native banner between card and footer ── -->
      <div class="dl-native-mid">
        <script async="async" data-cfasync="false" src="https://pl31179952.profitableratecpmnetwork.com/3660d37311472ae17c69dda162f6f3e8/invoke.js"></script>
        <div id="container-3660d37311472ae17c69dda162f6f3e8-2"></div>
      </div>

    </div>
  </div>

  <!-- ── Social Bar: sticky bottom ── -->
  <script src="https://pl31179951.profitableratecpmnetwork.com/ed/48/20/ed4820834bce5d1401202cbcc1cc7dd6.js"></script>

</BaseLayout>

<script define:vars={{ type, id, season, episode, COUNTDOWN }}>
  const secsEl     = document.getElementById('dl-secs');
  const barEl      = document.getElementById('dl-bar');
  const progressEl = document.getElementById('dl-progress');
  const countdownEl= document.getElementById('dl-countdown');
  const statusEl   = document.getElementById('dl-status');
  const statusTxt  = document.getElementById('dl-status-text');
  const btn        = document.getElementById('dl-btn');

  let streamUrl    = null;
  let fetchDone    = false;
  let countdownDone= false;

  // ── 1. Fetch stream URL directly from the public stream server ──
  // servers.jpaworx.com is public HTTPS — no proxy needed.
  // Calling it client-side avoids Cloudflare's origin timeout on /api/download.
  async function fetchStream() {
    try {
      let apiUrl;
      if (type === 'tv') {
        apiUrl = `https://servers.jpaworx.com/stream/vidzee/tv/${id}/${season}/${episode}`;
      } else {
        apiUrl = `https://servers.jpaworx.com/stream/vidzee/movie/${id}`;
      }

      const res = await fetch(apiUrl);

      if (!res.ok) {
        showError(`Stream server error (${res.status})`);
        return;
      }

      const data = await res.json();
      const directUrl = data?.extracted?.url ?? data?.extracted?.streams?.[0]?.url;

      if (data.ok && directUrl) {
        streamUrl = directUrl;
        fetchDone = true;
        if (countdownDone) revealButton();
      } else {
        showError('Download link unavailable for this title.');
      }
    } catch (err) {
      console.error('[download]', err);
      showError('Could not reach the download server. Please try again later.');
    }
  }

  // ── 2. Countdown timer ──
  let remaining = COUNTDOWN;

  function tick() {
    remaining -= 1;
    if (secsEl) secsEl.textContent = String(remaining);
    const pct = ((COUNTDOWN - remaining) / COUNTDOWN) * 100;
    if (barEl) barEl.style.width = `${pct}%`;
    if (progressEl) progressEl.setAttribute('aria-valuenow', String(COUNTDOWN - remaining));

    if (remaining <= 0) {
      countdownDone = true;
      if (countdownEl) {
        countdownEl.style.opacity = '0';
        countdownEl.style.pointerEvents = 'none';
        setTimeout(() => { if (countdownEl) countdownEl.style.display = 'none'; }, 400);
      }
      if (fetchDone) revealButton();
      else if (statusTxt) statusTxt.textContent = 'Almost ready…';
      return;
    }
    setTimeout(tick, 1000);
  }

  setTimeout(tick, 1000);

  // ── 3. Reveal button ──
  function revealButton() {
    if (!streamUrl || !btn) return;
    btn.href = streamUrl;
    btn.removeAttribute('aria-disabled');
    btn.removeAttribute('tabindex');
    if (statusEl) statusEl.style.display = 'none';
    btn.style.display = 'inline-flex';
    btn.focus();
  }

  function showError(msg) {
    console.error('[download]', msg);
    if (statusEl) statusEl.style.display = 'none';
    if (btn) btn.style.display = 'none';
    if (countdownEl) countdownEl.style.display = 'none';
    const actionsEl = document.getElementById('dl-actions');
    if (actionsEl) {
      actionsEl.querySelectorAll('.dl-error').forEach(el => el.remove());
      const err = document.createElement('p');
      err.className = 'dl-error';
      err.textContent = msg;
      actionsEl.prepend(err);
    }
  }

  fetchStream();
</script>

<style>
  /* ── Page ─────────────────────────────────────────────────── */
  .dl-page {
    padding-bottom: var(--space-16);
    margin-top: var(--navbar-h);
    min-height: calc(100vh - var(--navbar-h));
  }

  /* ── Native banner zones ─────────────────────────────────── */
  .dl-native-top {
    width: 100%;
    background: var(--clr-bg-2);
    border-bottom: 1px solid var(--clr-border);
    padding-block: var(--space-3);
    overflow: hidden;
  }

  .dl-native-mid {
    margin-top: var(--space-8);
    overflow: hidden;
  }

  /* ── Back link ───────────────────────────────────────────── */
  .dl-back {
    padding-top: var(--space-6);
    margin-bottom: var(--space-5);
  }

  .dl-back__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--text-sm);
    color: var(--clr-text-secondary);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .dl-back__link:hover { color: var(--clr-accent); }

  /* ── Main card ───────────────────────────────────────────── */
  .dl-card {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: var(--space-8);
    background: var(--clr-bg-card);
    border: 1px solid var(--clr-border);
    border-radius: var(--radius-2xl, 1.5rem);
    padding: var(--space-8);
    align-items: start;
  }

  .dl-card__poster {
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: 0 8px 40px rgba(0, 0, 0, 0.5);
    position: sticky;
    top: calc(var(--navbar-h) + var(--space-4));
  }

  .dl-card__poster img {
    width: 100%;
    height: auto;
    display: block;
  }

  .dl-card__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  /* ── Meta + title ────────────────────────────────────────── */
  .dl-card__meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .dl-card__type-pill {
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 3px 10px;
    border-radius: 99px;
    background: var(--clr-accent);
    color: #fff;
  }

  .dl-card__year {
    font-size: var(--text-sm);
    color: var(--clr-text-muted);
  }

  .dl-card__title {
    font-family: var(--font-display);
    font-size: clamp(var(--text-2xl), 3vw, 2.5rem);
    color: var(--clr-text);
    line-height: 1.1;
    margin: 0;
  }

  .dl-card__ep {
    display: block;
    font-family: var(--font-body, inherit);
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--clr-text-secondary);
    margin-top: var(--space-1);
  }

  .dl-card__hint {
    font-size: var(--text-sm);
    color: var(--clr-text-muted);
    margin: 0;
    line-height: 1.6;
  }

  /* ── Countdown ───────────────────────────────────────────── */
  .dl-countdown {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-5);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--clr-border);
    border-radius: var(--radius-lg);
    transition: opacity 0.4s ease;
  }

  .dl-countdown__bar-wrap {
    height: 8px;
    background: rgba(255, 255, 255, 0.08);
    border-radius: 99px;
    overflow: hidden;
  }

  .dl-countdown__bar {
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, var(--clr-accent), #a855f7, #ec4899);
    border-radius: 99px;
    transition: width 0.9s linear;
  }

  .dl-countdown__label {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--clr-text-secondary);
    margin: 0;
  }

  .dl-countdown__label strong {
    color: var(--clr-text);
    font-variant-numeric: tabular-nums;
    min-width: 2ch;
  }

  /* ── Actions ─────────────────────────────────────────────── */
  .dl-actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .dl-status {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-sm);
    color: var(--clr-text-secondary);
  }

  .dl-spinner {
    display: inline-block;
    width: 18px;
    height: 18px;
    border: 2px solid rgba(255, 255, 255, 0.15);
    border-top-color: var(--clr-accent);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
    flex-shrink: 0;
  }

  @keyframes spin { to { transform: rotate(360deg); } }

  .dl-btn {
    display: none;
    align-self: flex-start;
    gap: var(--space-2);
  }

  .dl-disclaimer {
    font-size: var(--text-xs);
    color: var(--clr-text-muted);
    margin: 0;
  }

  .dl-error {
    font-size: var(--text-sm);
    color: #ef4444;
    padding: var(--space-3) var(--space-4);
    background: rgba(239, 68, 68, 0.08);
    border: 1px solid rgba(239, 68, 68, 0.2);
    border-radius: var(--radius-lg);
    margin: 0;
  }

  /* ── Responsive ──────────────────────────────────────────── */
  @media (max-width: 640px) {
    .dl-card {
      grid-template-columns: 1fr;
      padding: var(--space-5);
      gap: var(--space-5);
    }

    .dl-card__poster {
      width: 130px;
      margin: 0 auto;
      position: static;
    }
  }
</style>
