---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import MovieCard from '../../components/MovieCard.astro';
import {
  getPopularMovies,
  getTopRatedMovies,
  getNowPlayingMovies,
  getUpcomingMovies,
  getMoviesByGenre,
  getMovieGenres,
} from '../../lib/tmdb';
import type { Movie } from '../../lib/tmdb';

// Read filter params from URL
const url       = Astro.url;
const genreId   = url.searchParams.get('genre') ? Number(url.searchParams.get('genre')) : null;
const category  = url.searchParams.get('cat') ?? 'popular';
const page      = Math.max(1, Number(url.searchParams.get('page') ?? '1'));

// Fetch genres and current category concurrently
const [genresData, moviesData] = await Promise.all([
  getMovieGenres(),
  genreId
    ? getMoviesByGenre(genreId, page)
    : category === 'top_rated'
      ? getTopRatedMovies(page)
      : category === 'now_playing'
        ? getNowPlayingMovies(page)
        : category === 'upcoming'
          ? getUpcomingMovies(page)
          : getPopularMovies(page),
]);

const genres  = genresData.genres;
const movies  = moviesData.results as Movie[];
const total   = moviesData.total_pages;

const activeGenre = genres.find(g => g.id === genreId);

const categories = [
  { key: 'popular',     label: 'Popular' },
  { key: 'top_rated',   label: 'Top Rated' },
  { key: 'now_playing', label: 'Now Playing' },
  { key: 'upcoming',    label: 'Upcoming' },
];

function buildUrl(params: Record<string, string | number | null>) {
  const p = new URLSearchParams();
  for (const [k, v] of Object.entries(params)) {
    if (v !== null && v !== undefined && v !== '') p.set(k, String(v));
  }
  return `/movies?${p.toString()}`;
}

const pageTitle = activeGenre
  ? `${activeGenre.name} Movies`
  : categories.find(c => c.key === category)?.label + ' Movies';
---

<BaseLayout
  title={`${pageTitle} | StreamVault`}
  description={`Browse ${pageTitle.toLowerCase()} on StreamVault. Discover the best films curated from TMDB.`}
>
  <div class="movies-page">
    <div class="movies-page__header">
      <div class="container">
        <h1 class="movies-page__title">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <rect x="2" y="2" width="20" height="20" rx="3"/>
            <path d="M7 2v20M17 2v20M2 12h20M2 7h5M2 17h5M17 7h5M17 17h5"/>
          </svg>
          Movies
        </h1>

        <!-- Category tabs -->
        <nav class="filter-tabs" aria-label="Movie categories">
          <ul role="list">
            {categories.map(cat => (
              <li>
                <a
                  href={buildUrl({ cat: cat.key, page: 1 })}
                  class:list={['filter-tab', { 'filter-tab--active': !genreId && category === cat.key }]}
                  aria-current={!genreId && category === cat.key ? 'page' : undefined}
                >
                  {cat.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>

        <!-- Genre pills -->
        <div class="genre-filter" aria-label="Filter by genre">
          <span class="genre-filter__label">Genre:</span>
          <div class="genre-filter__pills">
            <a
              href={buildUrl({ cat: category, page: 1 })}
              class:list={['genre-pill', { 'active': !genreId }]}
              aria-current={!genreId ? 'true' : undefined}
            >
              All
            </a>
            {genres.map(genre => (
              <a
                href={buildUrl({ genre: genre.id, page: 1 })}
                class:list={['genre-pill', { 'active': genreId === genre.id }]}
                aria-current={genreId === genre.id ? 'true' : undefined}
              >
                {genre.name}
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>

    <!-- Results -->
    <div class="container">
      <p class="results-count" aria-live="polite">
        Showing page <strong>{page}</strong> of <strong>{total}</strong>
        {activeGenre ? ` — ${activeGenre.name}` : ''}
      </p>

      {movies.length === 0 ? (
        <div class="empty-state">
          <p>No movies found. Try a different filter.</p>
          <a href="/movies" class="btn btn--primary">Reset Filters</a>
        </div>
      ) : (
        <ul class="media-grid" role="list" aria-label={pageTitle}>
          {movies.map((movie, i) => (
            <li>
              <MovieCard item={movie} type="movie" lazy={i > 7} />
            </li>
          ))}
        </ul>
      )}

      <!-- Pagination -->
      {total > 1 && (
        <nav class="pagination" aria-label="Page navigation">
          {page > 1 && (
            <a
              href={buildUrl({ cat: genreId ? null : category, genre: genreId, page: page - 1 })}
              class="btn btn--ghost"
              aria-label="Previous page"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path d="m15 18-6-6 6-6"/>
              </svg>
              Previous
            </a>
          )}

          <div class="pagination__pages" aria-label="Page numbers">
            {Array.from({ length: Math.min(7, total) }, (_, i) => {
              // Show pages around current
              let p2: number;
              if (total <= 7) {
                p2 = i + 1;
              } else if (page <= 4) {
                p2 = i + 1;
              } else if (page >= total - 3) {
                p2 = total - 6 + i;
              } else {
                p2 = page - 3 + i;
              }
              return (
                <a
                  href={buildUrl({ cat: genreId ? null : category, genre: genreId, page: p2 })}
                  class:list={['pagination__page', { 'pagination__page--active': p2 === page }]}
                  aria-current={p2 === page ? 'page' : undefined}
                  aria-label={`Page ${p2}`}
                >
                  {p2}
                </a>
              );
            })}
          </div>

          {page < total && (
            <a
              href={buildUrl({ cat: genreId ? null : category, genre: genreId, page: page + 1 })}
              class="btn btn--ghost"
              aria-label="Next page"
            >
              Next
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path d="m9 18 6-6-6-6"/>
              </svg>
            </a>
          )}
        </nav>
      )}
    </div>
  </div>
</BaseLayout>

<style>
  .movies-page__header {
    background: var(--clr-bg-2);
    border-bottom: 1px solid var(--clr-border);
    padding-top: calc(var(--navbar-h) + var(--space-8));
    padding-bottom: var(--space-6);
  }

  .movies-page__title {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-family: var(--font-display);
    font-size: clamp(var(--text-3xl), 5vw, var(--text-5xl));
    letter-spacing: 0.03em;
    margin-bottom: var(--space-6);
    color: var(--clr-text);
  }

  /* Category tabs */
  .filter-tabs ul {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
    margin-bottom: var(--space-4);
  }

  .filter-tab {
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-full);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--clr-text-secondary);
    background: var(--clr-bg-elevated);
    border: 1px solid var(--clr-border);
    transition: all var(--transition-fast);
    white-space: nowrap;
  }

  .filter-tab:hover {
    color: var(--clr-text);
    border-color: var(--clr-border-strong);
  }

  .filter-tab--active {
    background: var(--clr-accent);
    color: #fff;
    border-color: var(--clr-accent);
  }

  /* Genre filter */
  .genre-filter {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .genre-filter__label {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--clr-text-muted);
    padding-top: 2px;
    white-space: nowrap;
  }

  .genre-filter__pills {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  /* Results */
  .results-count {
    font-size: var(--text-sm);
    color: var(--clr-text-muted);
    padding-block: var(--space-6) var(--space-4);
  }

  .results-count strong {
    color: var(--clr-text-secondary);
  }

  /* Grid */
  .media-grid {
    margin-bottom: var(--space-12);
  }

  /* Empty state */
  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-6);
    padding-block: var(--space-20);
    color: var(--clr-text-secondary);
    font-size: var(--text-lg);
    text-align: center;
  }

  /* Pagination */
  .pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    padding-block: var(--space-8) var(--space-12);
    flex-wrap: wrap;
  }

  .pagination__pages {
    display: flex;
    gap: var(--space-1);
  }

  .pagination__page {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--clr-text-secondary);
    background: var(--clr-bg-elevated);
    border: 1px solid var(--clr-border);
    transition: all var(--transition-fast);
  }

  .pagination__page:hover {
    color: var(--clr-text);
    border-color: var(--clr-border-strong);
  }

  .pagination__page--active {
    background: var(--clr-accent);
    color: #fff;
    border-color: var(--clr-accent);
  }
</style>
