---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import MovieCard from '../../components/MovieCard.astro';
import SearchBar from '../../components/SearchBar.astro';
import { searchMulti, imgUrl, formatYear } from '../../lib/tmdb';
import type { SearchResult } from '../../lib/tmdb';

const query  = Astro.url.searchParams.get('q')?.trim() ?? '';
const page   = Math.max(1, Number(Astro.url.searchParams.get('page') ?? '1'));

let results: SearchResult[] = [];
let totalPages = 0;
let totalResults = 0;
let searchError = false;

if (query) {
  try {
    const data = await searchMulti(query, page);
    // Filter out people (we only show movies + tv)
    results      = data.results.filter(r => r.media_type === 'movie' || r.media_type === 'tv');
    totalPages   = data.total_pages;
    totalResults = data.total_results;
  } catch {
    searchError = true;
  }
}

function buildUrl(p: number) {
  const params = new URLSearchParams();
  params.set('q', query);
  if (p > 1) params.set('page', String(p));
  return `/search?${params.toString()}`;
}
---

<BaseLayout
  title={query ? `"${query}" — Search | StreamVault` : 'Search | StreamVault'}
  description={query ? `Search results for "${query}" on StreamVault.` : 'Search for movies and TV shows on StreamVault.'}
>
  <div class="search-page">
    <!-- Hero search header -->
    <div class="search-page__header">
      <div class="container">
        <h1 class="search-page__title">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <circle cx="11" cy="11" r="8"/>
            <path d="m21 21-4.35-4.35"/>
          </svg>
          Search
        </h1>
        <SearchBar initialQuery={query} large={true} placeholder="Movies, TV shows, genres..." />
      </div>
    </div>

    <div class="container">
      <!-- States -->
      {searchError && (
        <div class="search-state search-state--error" role="alert">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <circle cx="12" cy="12" r="10"/>
            <path d="M12 8v4M12 16h.01"/>
          </svg>
          <p>Something went wrong fetching results. Please try again.</p>
        </div>
      )}

      {!query && !searchError && (
        <div class="search-state search-state--empty">
          <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true">
            <circle cx="11" cy="11" r="8"/>
            <path d="m21 21-4.35-4.35"/>
          </svg>
          <h2>What do you want to watch?</h2>
          <p>Search for movies, TV shows, and more above.</p>
          <div class="search-suggestions" aria-label="Suggested searches">
            <span class="search-suggestions__label">Try:</span>
            {['Dune', 'Breaking Bad', 'Interstellar', 'The Bear', 'Oppenheimer'].map(term => (
              <a href={`/search?q=${encodeURIComponent(term)}`} class="genre-pill">{term}</a>
            ))}
          </div>
        </div>
      )}

      {query && !searchError && results.length === 0 && (
        <div class="search-state search-state--no-results">
          <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true">
            <circle cx="11" cy="11" r="8"/>
            <path d="m21 21-4.35-4.35"/>
            <path d="m8 13 1.5-1.5 1 1L13 10"/>
          </svg>
          <h2>No results for "{query}"</h2>
          <p>Try a different title, actor, or genre.</p>
          <a href="/search" class="btn btn--ghost">Clear Search</a>
        </div>
      )}

      {query && !searchError && results.length > 0 && (
        <>
          <div class="search-results-header" aria-live="polite">
            <p class="search-results-count">
              <strong>{totalResults.toLocaleString()}</strong> results for
              <em>"{query}"</em>
              {totalPages > 1 && ` — page ${page} of ${totalPages}`}
            </p>
          </div>

          <ul class="media-grid" role="list" aria-label={`Search results for ${query}`}>
            {results.map((item, i) => {
              const isMovie = item.media_type === 'movie';
              // Cast to compatible shape for MovieCard
              const cardItem = isMovie
                ? { ...item, title: item.title ?? item.name ?? 'Untitled', release_date: item.release_date ?? '', genre_ids: item.genre_ids ?? [] }
                : { ...item, name: item.name ?? item.title ?? 'Untitled', first_air_date: item.first_air_date ?? '', genre_ids: item.genre_ids ?? [] };
              return (
                <li>
                  <MovieCard
                    item={cardItem as any}
                    type={item.media_type as 'movie' | 'tv'}
                    lazy={i > 7}
                  />
                </li>
              );
            })}
          </ul>

          <!-- Pagination -->
          {totalPages > 1 && (
            <nav class="pagination" aria-label="Search result pages">
              {page > 1 && (
                <a href={buildUrl(page - 1)} class="btn btn--ghost" aria-label="Previous page">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                    <path d="m15 18-6-6 6-6"/>
                  </svg>
                  Previous
                </a>
              )}

              <div class="pagination__pages">
                {Array.from({ length: Math.min(7, totalPages) }, (_, i) => {
                  let p2: number;
                  if (totalPages <= 7) {
                    p2 = i + 1;
                  } else if (page <= 4) {
                    p2 = i + 1;
                  } else if (page >= totalPages - 3) {
                    p2 = totalPages - 6 + i;
                  } else {
                    p2 = page - 3 + i;
                  }
                  return (
                    <a
                      href={buildUrl(p2)}
                      class:list={['pagination__page', { 'pagination__page--active': p2 === page }]}
                      aria-current={p2 === page ? 'page' : undefined}
                      aria-label={`Page ${p2}`}
                    >
                      {p2}
                    </a>
                  );
                })}
              </div>

              {page < totalPages && (
                <a href={buildUrl(page + 1)} class="btn btn--ghost" aria-label="Next page">
                  Next
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                    <path d="m9 18 6-6-6-6"/>
                  </svg>
                </a>
              )}
            </nav>
          )}
        </>
      )}
    </div>
  </div>
</BaseLayout>

<style>
  .search-page__header {
    background: var(--clr-bg-2);
    border-bottom: 1px solid var(--clr-border);
    padding-top: calc(var(--navbar-h) + var(--space-10));
    padding-bottom: var(--space-8);
  }

  .search-page__title {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-family: var(--font-display);
    font-size: clamp(var(--text-3xl), 5vw, var(--text-5xl));
    letter-spacing: 0.03em;
    margin-bottom: var(--space-6);
  }

  /* States */
  .search-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    padding-block: var(--space-20);
    text-align: center;
    color: var(--clr-text-secondary);
  }

  .search-state svg {
    color: var(--clr-text-muted);
    opacity: 0.5;
  }

  .search-state h2 {
    font-size: var(--text-2xl);
    font-weight: 700;
    color: var(--clr-text);
  }

  .search-state p {
    font-size: var(--text-base);
    color: var(--clr-text-secondary);
    max-width: 400px;
  }

  .search-state--error svg,
  .search-state--error p {
    color: var(--clr-error);
  }

  /* Suggestions */
  .search-suggestions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
    justify-content: center;
    margin-top: var(--space-2);
  }

  .search-suggestions__label {
    font-size: var(--text-sm);
    color: var(--clr-text-muted);
    font-weight: 600;
  }

  /* Results header */
  .search-results-header {
    padding-block: var(--space-6) var(--space-4);
  }

  .search-results-count {
    font-size: var(--text-sm);
    color: var(--clr-text-muted);
  }

  .search-results-count strong {
    color: var(--clr-text);
    font-size: var(--text-base);
  }

  .search-results-count em {
    color: var(--clr-text-secondary);
    font-style: normal;
    font-weight: 600;
  }

  /* Grid */
  .media-grid {
    margin-bottom: var(--space-8);
  }

  /* Pagination */
  .pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    padding-block: var(--space-8) var(--space-12);
    flex-wrap: wrap;
  }

  .pagination__pages {
    display: flex;
    gap: var(--space-1);
  }

  .pagination__page {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--clr-text-secondary);
    background: var(--clr-bg-elevated);
    border: 1px solid var(--clr-border);
    transition: all var(--transition-fast);
  }

  .pagination__page:hover {
    color: var(--clr-text);
    border-color: var(--clr-border-strong);
  }

  .pagination__page--active {
    background: var(--clr-accent);
    color: #fff;
    border-color: var(--clr-accent);
  }
</style>
