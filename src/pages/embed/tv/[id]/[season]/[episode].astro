---
export const prerender = false;

const { id, season, episode } = Astro.params;
if (!id || isNaN(Number(id))) return Astro.redirect('/404');
if (!season || isNaN(Number(season))) return Astro.redirect('/404');
if (!episode || isNaN(Number(episode))) return Astro.redirect('/404');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Loading player…</title>
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      html, body { width: 100%; height: 100%; background: #000; overflow: hidden; }
      iframe { width: 100%; height: 100%; border: none; display: block; }
    </style>
  </head>
  <body>
    <!--
      Proxied TV episode embed — loaded as an iframe on the watch page.
      /api/embed handles: Referer/Origin headers, aclib.js + sbx.js stripping,
      and relative URL rewriting.
    -->
    <iframe
      src={`/api/embed?type=tv&id=${id}&season=${season}&episode=${episode}`}
      allow="autoplay; encrypted-media; fullscreen; picture-in-picture"
      allowfullscreen
      referrerpolicy="no-referrer"
    ></iframe>
  </body>
</html>
