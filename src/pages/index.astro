---
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import MediaRow from '../components/MediaRow.astro';
import SearchBar from '../components/SearchBar.astro';
import ContinueWatching from '../components/ContinueWatching.astro';
import NetflixTop10 from '../components/NetflixTop10.astro';
import {
  getCarouselItems,
  getTrendingMovies,
  getTrendingTV,
  getTopRatedMovies,
  getTopRatedTV,
  getNetflixTop10,
} from '../lib/tmdb';

// Fetch all data concurrently for performance
const [
  carouselItems,
  trendingMovies,
  trendingTV,
  topRatedMovies,
  topRatedTV,
  netflixTop10,
] = await Promise.all([
  getCarouselItems(),
  getTrendingMovies('week'),
  getTrendingTV('week'),
  getTopRatedMovies(),
  getTopRatedTV(),
  getNetflixTop10(),
]);

// Hero: use Supabase-curated carousel; fall back to trending mix if empty
const heroItems = carouselItems.length > 0
  ? carouselItems
  : [
      ...trendingMovies.results.slice(0, 3),
      ...trendingTV.results.slice(0, 2),
    ].slice(0, 5);
---

<BaseLayout
  title="Flixworld — Watch Movies & TV Shows"
  description="Discover trending movies and TV shows. Browse top-rated films, popular series, and now-playing content — all in one place."
>
  <HeroSection items={heroItems} />

  <!-- Search bar strip -->
  <div class="home-search">
    <div class="container">
      <div class="home-search__inner">
        <p class="home-search__label">What are you looking for?</p>
        <SearchBar placeholder="Search movies, TV shows, genres..." />
      </div>
    </div>
  </div>

  <!-- Continue Watching (hidden until localStorage has entries) -->
  <ContinueWatching />

  <!-- Netflix Top 10 Today -->
  <NetflixTop10 items={netflixTop10} />

  <!-- Trending Movies -->
  <MediaRow
    title="Trending Movies"
    items={trendingMovies.results.slice(0, 20)}
    type="movie"
    viewAllHref="/movies"
  />

  <!-- Top Rated Movies -->
  <MediaRow
    title="Top Rated Movies"
    items={topRatedMovies.results.slice(0, 20)}
    type="movie"
    viewAllHref="/movies"
  />

  <!-- Trending TV -->
  <MediaRow
    title="Trending Series"
    items={trendingTV.results.slice(0, 20)}
    type="tv"
    viewAllHref="/tv"
  />

  <!-- Top Rated TV -->
  <MediaRow
    title="Top Rated Series"
    items={topRatedTV.results.slice(0, 20)}
    type="tv"
    viewAllHref="/tv"
  />

  <!-- TMDB attribution -->
  <div class="tmdb-attr container">
    <img
      src="https://www.themoviedb.org/assets/2/v4/logos/v2/blue_short-8e7b30f73a4020692ccca9c88bafe5dcb6f8a62a4c6bc55cd9ba82bb2cd95f6c.svg"
      alt="This product uses the TMDB API"
      width="130"
      height="18"
      loading="lazy"
      decoding="async"
    />
    <span>This product uses the TMDB API but is not endorsed or certified by TMDB.</span>
  </div>
</BaseLayout>

<style>
  .home-search {
    padding-block: var(--space-10) var(--space-6);
    background: linear-gradient(to bottom, var(--clr-bg-2), var(--clr-bg));
  }

  .home-search__inner {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    flex-wrap: wrap;
  }

  .home-search__label {
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--clr-text-secondary);
    white-space: nowrap;
  }

  .tmdb-attr {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding-block: var(--space-8);
    color: var(--clr-text-muted);
    font-size: var(--text-xs);
    flex-wrap: wrap;
  }

  @media (max-width: 640px) {
    .home-search__label { display: none; }
    .home-search__inner { justify-content: center; }
  }
</style>
